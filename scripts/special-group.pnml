group_props1(special_group,
              boxcar_11_259,
              hopper_17_486, 1988)

item (FEAT_TRAINS, special_group, 1320) {
  property {
    name: string(STR_NAME_SPECIAL_SERIES);
    group_wagon(1984, 10)
  }
  graphics {
    purchase_menu(PROP_special_group_CF, PROP_special_group_RC, PROP_special_group_SD, PROP_special_group_WT, PROP_special_group_TE, PROP_special_group_PR, PROP_special_group_LC)
    name: special_group_name;
    purchase_menu(PROP_special_group_CF, PROP_special_group_RC, PROP_special_group_SD, PROP_special_group_WT, PROP_special_group_TE, PROP_special_group_PR, PROP_special_group_LC)
    name: special_group_name;
    group_CBs(special_group)
    colour_mapping: return ttdall_cc + 0x49;
  }
}
