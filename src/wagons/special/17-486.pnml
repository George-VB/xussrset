// 17_486_hopper

#define PROP_hopper_17_486_CF  2 * 77
#define PROP_hopper_17_486_RC  30
#define PROP_hopper_17_486_SD  120
#define PROP_hopper_17_486_WT  30
#define PROP_hopper_17_486_TE  0
#define PROP_hopper_17_486_PR  0
#define PROP_hopper_17_486_CC  83
#define PROP_hopper_17_486_LC  52
#define PROP_hopper_17_486_AC  0
#define PROP_hopper_17_486_VC  86

#define IMAGEFILE  "src/wagons/special/17-486.png"
purchase_sprites(hopper_17_486, 0, 0)
tanker_layout_template(hopper_17_486, 10, 32, 40)
#undef IMAGEFILE
long_vehicle(hopper_17_486)

switch (FEAT_TRAINS, SELF, hopper_17_486_cargo_capacity,
  [ STORE_TEMP(round(PROP_hopper_17_486_LC), 0),  // т
    STORE_TEMP(round(PROP_hopper_17_486_VC), 1),  // м³
    STORE_TEMP(round(PROP_hopper_17_486_AC), 2),  // м²
    STORE_TEMP(0, 3),                             // палетомест
    STORE_TEMP(10, 4)])                           // шаблон
{ hopper_cargo_capacity; }

switch (FEAT_TRAINS, SELF, hopper_17_486_running_cost_factor,
  [ STORE_TEMP(0, 0),   // Моторы
    STORE_TEMP(0, 1),   // Бригада
    STORE_TEMP(20, 2),  // Износ
    STORE_TEMP(0, 3),   // Сопровождение
    STORE_TEMP(10, 4),  // ТО
    STORE_TEMP(0, 5),   // Сертификация

    STORE_TEMP(PROP_hopper_17_486_SD, 6),                                  // Скорость
    STORE_TEMP(round(PROP_hopper_17_486_WT), 7),                           // Тара
    STORE_TEMP(round(PROP_hopper_17_486_WT + PROP_hopper_17_486_LC), 8)])  // Максимальная масса
{ all_running_cost_factor; }                                               // 30

switch (FEAT_TRAINS, SELF, hopper_17_486_loading_speed,
  [ STORE_TEMP(0, 0),
    STORE_TEMP(0, 1),
    STORE_TEMP(4 * LARGE_HATCH, 2),   // 4 больших погрузочных люка
    STORE_TEMP(4 * SMALL_HATCH, 3)])  // 4 малых разгрузочных люка
{ all_wagons_hopper_loading_speed; }

name_in_wagon_group(hopper_17_486,
  string(STR_NAME_IN_GROUP, string(STR_NAME_SPECIAL_SERIES), string(STR_MODEL_NUMBER2, 17, 486)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_SPECIAL_SERIES), string(STR_LONGNAME_BUNKER_17_486)))

hint_wagon_with_uspeed(hopper_17_486,
  round(PROP_hopper_17_486_LC), round(PROP_hopper_17_486_VC),
  calc_loading(PROP_hopper_17_486_LC / (4 * LARGE_HATCH)),
  calc_loading(PROP_hopper_17_486_LC / (4 * SMALL_HATCH)),
  get_CAP_in_cb(CAP_001_NORMAL),
  STR_PURCHASE_HINT_WAGON_TYPE_BUNKER,
  1988, 2014,
  fact_stakhanovcw())

item (FEAT_TRAINS, hopper_17_486, 617) {
  property {
    name: string(STR_MODEL_NUMBER2, 17, 486);
    vehicle_dates(1988, 2014, 30, 10, 8, PROP_hopper_17_486_CF)
    vehicle_wagon(PROP_hopper_17_486_WT, PROP_hopper_17_486_SD)
    vehicle_group_wagon(group_special)
    cargo_allow_refit: [cargo_all_flour_bunkerlist()];
  }
  graphics {
    purchase_menu(PROP_hopper_17_486_CF, PROP_hopper_17_486_RC, PROP_hopper_17_486_SD, PROP_hopper_17_486_WT, PROP_hopper_17_486_TE, PROP_hopper_17_486_PR, PROP_hopper_17_486_LC)
        additional_text: hopper_17_486_additional_text;
       articulated_part: articulated_part_dummy2;
       cargo_age_period: return get_CAP_in_cb(CAP_001_NORMAL);
         cargo_capacity: hopper_17_486_cargo_capacity;
         colour_mapping: any_cc_colour;
                default: hopper_17_486_sprites;
          loading_speed: hopper_17_486_loading_speed;
                   name: hopper_17_486_name;
               purchase: hopper_17_486_purchase_sprites;
             refit_cost: return 0 | CB_RESULT_AUTOREFIT;
    running_cost_factor: hopper_17_486_running_cost_factor;
  }
}

long_name_template(hopper_17_486, STR_LONGNAME_BUNKER_17_486)
allow_wagon(hopper_17_486)
