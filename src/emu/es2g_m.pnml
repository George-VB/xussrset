// es2g uses es1

#define PROP_es2g_m_CF  2 * 121
#define PROP_es2g_m_RC  687
#define PROP_es2g_m_SD  160
#define PROP_es2g_m_WT  56.4
#define PROP_es2g_m_TE  128
#define PROP_es2g_m_PR  1993
#define PROP_es2g_m_CC  94

#define IMAGEFILE  "src/emu/es2g_m.png"
purchase_sprites_with_icon(es2g_m, 18, 0, 3dc)
MU_car_sprites(14, es2g_m, 32, 40)
#undef IMAGEFILE

switch (FEAT_TRAINS, PARENT, es2g_m_direction_left,
  tep70bs_es1_2() + 2 * (vehicle_type_id == es2g_hm))
{
  2: es2g_m_sprites_left;
  1: es2g_m_sprites_left;
  es2g_m_notpowered_sprites_left;
}

switch (FEAT_TRAINS, PARENT, es2g_m_direction_right,
  tep70bs_es1_2() + 2 * (vehicle_type_id == es2g_hm))
{
  2: es2g_m_sprites_right;
  1: es2g_m_sprites_right;
  es2g_m_notpowered_sprites_right;
}

#define EMU_es2g_m_template(name)                                         \
switch (FEAT_TRAINS, SELF, name##_m_direction_max, LOAD_TEMP(5))          \
{ 0x4000119: name##_m_direction_left;    /* Г-Т-П-Т-(М)-Т-Г           */  \
  0x2000191: name##_m_direction_right;   /* Г-Т-(М)-Т-П-Т-Г           */  \
  0x2006419: name##_m_direction_right;   /* Г-Т-(М)-Т-П-П-Т-М-Т-Г     */  \
  0x7006419: name##_m_direction_left;    /* Г-Т-М-Т-П-П-Т-(М)-Т-Г     */  \
  0x2064619: name##_m_direction_right;   /* Г-Т-(М)-Т-П-Т-М-П-Т-М-Т-Г */  \
  0x6064619: name##_m_direction_left;    /* Г-Т-М-Т-П-Т-(М)-П-Т-М-Т-Г */  \
  0x9064619: name##_m_direction_left;    /* Г-Т-М-Т-П-Т-М-П-Т-(М)-Т-Г */  \
  0x2064919: name##_m_direction_right;   /* Г-Т-(М)-Т-П-М-Т-П-Т-М-Т-Г */  \
  0x5064919: name##_m_direction_right;   /* Г-Т-М-Т-П-(М)-Т-П-Т-М-Т-Г */  \
  0x9064919: name##_m_direction_left;    /* Г-Т-М-Т-П-М-Т-П-Т-(М)-Т-Г */  \
  name##_m_direction_left; }                                              \

EMU_es2g_m_template(es2g)
EMU_direction_calculation_template2b(es2g_m, es2g_cp, es2g_m, es1, es2g_hm, es2g_hm, es2g_hm, es2g_hm)
EMU_es2g_attach_wagon_icon_template(es2g_m)
EMU_attach_calculation_template2b(es2g_m_next, es2g_cp, es2g_m, es1, es2g_hm, es2g_hm, es2g_hm, es2g_hm)
MU_attach_wagon_icon_template2_extracheckparent(es2g_m, es2g_hm, TEP70BS_ID, type_car_motor, (vehicle_type_id == es2g_hm) || tep70bs_es1_2())
long_vehicle_advanced(es2g_m, es2g_m_sprites_start_sp)

switch (FEAT_TRAINS, PARENT, es2g_m_cargo_capacity, (vehicle_type_id == es2g_hm) || tep70bs_es1_2())
{  1: return PROP_es2g_m_CC;
  return 0;  }

engine_power_MU(es2g_m, PROP_es2g_m_PR, es2g_hm)

RC_head_check(es2g_m, es2g_hm)
switch (FEAT_TRAINS, SELF, es2g_m_running_cost_factor,
  [ STORE_TEMP(392, 0),  // Моторы
    STORE_TEMP(0, 1),    // Бригада
    STORE_TEMP(137, 2),  // Износ
    STORE_TEMP(0, 3),    // Сопровождение
    STORE_TEMP(96, 4),   // ТО
    STORE_TEMP(7, 5),    // Сертификация

    STORE_TEMP(PROP_es2g_m_SD, 6),                                // Скорость
    STORE_TEMP(round(PROP_es2g_m_WT), 7),                         // Тара
    STORE_TEMP(round(PROP_es2g_m_WT + PROP_es2g_m_CC / 16), 8)])  // Максимальная масса
{ es2g_m_check_running_cost_factor; }                             // 687

name_in_group_subgroup(es2g_m,
  string(STR_NAME_IN_GROUP, string(STR_NAME_ES_SERIES), string(STR_NAME_ES2G_M)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_ES_SERIES), string(STR_LONGNAME_ES2G_M)),
  string(STR_NAME_ES2G))

hint_MU_with_subtype_comment_PTE(es2g_m,
  calc_loading(PROP_es2g_m_CC / (2 * WIDERST_D_DOOR)),
  get_CAP_in_cb(CAP_0005_FAST),
  STR_PURCHASE_HINT_ENGINE_TYPE_EMU_M_DC_WITH_SUBTYPE, STR_PURCHASE_HINT_DESIRO,
  STR_SECTIONS_EMU_ES2G,
  2018, 2023,
  string(STR_PURCHASE_HINT_FACTORY_URAL),
  string(STR_PURCHASE_HINT_TEP70BS),
  string(STR_NAME_ES2G), PROP_es2g_m_PR, PROP_es2g_m_TE)

item (FEAT_TRAINS, es2g_m, 631) {
  property {
    name: string(STR_NAME_ES2G_M);
    vehicle_dates(2018, 2023, 40, 10, 8, PROP_es2g_m_CF)
    vehicle_emu_wagon(dc, PROP_es2g_m_WT, PROP_es2g_m_CC, 2 * WIDERST_D_DOOR, _highspeed)
    vehicle_group_mu(es2g_hm)
  }
  graphics {
    purchase_menu_wagon(PROP_es2g_m_CF, PROP_es2g_m_RC, PROP_es2g_m_SD, PROP_es2g_m_WT, PROP_es2g_m_TE, PROP_es2g_m_PR, PROP_es2g_m_CC)
                additional_text: es2g_m_additional_text;
               articulated_part: articulated_part_dummy6;
           bitmask_vehicle_info: es2g_bitmask_vehicle_info_advanced;
               can_attach_wagon: es2g_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_0005_FAST);
                 cargo_capacity: es2g_m_cargo_capacity;
                 colour_mapping: any_cc_colour;
                        default: es2g_m_sprites;
                           name: es2g_m_name;
                          power: es2g_m_power;
                       purchase: es2g_m_purchase_sprites;
            running_cost_factor: es2g_m_running_cost_factor;
                          speed: return 160;
                     start_stop: return string(STR_START_STOP_HEAD_REQUIRED);
    tractive_effort_coefficient: return get_tec_int(PROP_es2g_m_TE, PROP_es2g_m_WT);
  }
}

long_name_template(es2g_m, STR_LONGNAME_ES2G_M)
allow_dcemu(es2g_m)
