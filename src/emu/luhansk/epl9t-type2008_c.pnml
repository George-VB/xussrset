// epl9t

#define PROP_epl9t_type2008_c_CF  2 * (6)
#define PROP_epl9t_type2008_c_RC  45
#define PROP_epl9t_type2008_c_SD  130
#define PROP_epl9t_type2008_c_WT  49
#define PROP_epl9t_type2008_c_TE  0
#define PROP_epl9t_type2008_c_PR  0
#define PROP_epl9t_type2008_c_CC  130

#define IMAGEFILE  "src/emu/luhansk/epl9t-type2008_c.png"
purchase_sprites_with_icon(epl9t_type2008_c, 18, 0, 25ac)
MU_car_sprites(15, epl9t_type2008_c_mu, 32, 40)
#undef IMAGEFILE

MU_power_dir_template2(epl9t_type2008_c, epl9t_h, epl9t_type2008_h)
EMU_4_12_c_template(epl9t_type2008)
EMU_direction_calculation_template2set(epl9t_type2008_c, epl9t_h, epl9t_m, epl9t_c, epl9t_type2008_h, epl9t_type2008_m, epl9t_type2008_c)
EMU_4681012_attach_wagon_icon_template(epl9t_type2008_c)
EMU_attach_calculation_template2set(epl9t_type2008_c_next, epl9t_h, epl9t_m, epl9t_c, epl9t_type2008_h, epl9t_type2008_m, epl9t_type2008_c)
MU_attach_wagon_icon_template2(epl9t_type2008_c, epl9t_h, epl9t_type2008_h, type_car)
long_vehicle_advanced(epl9t_type2008_c, epl9t_type2008_c_sprites_start_sp)

engine_capacity_MU2(epl9t_type2008_c, PROP_epl9t_type2008_c_CC, epl9t_h, epl9t_type2008_h)

RC_head_check2(epl9t_type2008_c, epl9t_h, epl9t_type2008_h)
switch (FEAT_TRAINS, SELF, epl9t_type2008_c_running_cost_factor,
[  STORE_TEMP(26, 0),  // Моторы
   STORE_TEMP(0, 1),   // Бригада
   STORE_TEMP(9, 2),   // Износ
   STORE_TEMP(0, 3),   // Сопровождение
   STORE_TEMP(6, 4),   // ТО
   STORE_TEMP(0, 5),   // Сертификация

   STORE_TEMP(PROP_epl9t_type2008_c_SD, 6),                                          // Скорость
   STORE_TEMP(round(PROP_epl9t_type2008_c_WT), 7),                                   // Тара
   STORE_TEMP(round(PROP_epl9t_type2008_c_WT + PROP_epl9t_type2008_c_CC / 16), 8)])  // Максимальная масса
{ epl9t_type2008_c_check_running_cost_factor; }                                      // 45

name_in_group(epl9t_type2008_c, string(STR_NAME_IN_GROUP, string(STR_NAME_EPL9T_SERIES), string(STR_NAME_EPL9T_TYPE2008_C)),
                                string(STR_NAME_IN_GROUP, string(STR_NAME_EPL9T_SERIES), string(STR_LONGNAME_EPL9T_TYPE2008_C)))

hint_MU_in(epl9t_type2008_c,
     calc_loading(PROP_epl9t_type2008_c_CC / (3 * DOUBLE_DOOR)),
     STR_PURCHASE_HINT_CAP_00033_VERY_FAST,
     STR_PURCHASE_HINT_ENGINE_TYPE_EMU_C_AC,
     STR_SECTIONS_EMU_4_6_8_10_12,
     2008,
     fact_luhansk())

item (FEAT_TRAINS, epl9t_type2008_c, 1318) {
  property {
    name: string(STR_NAME_EPL9T_TYPE2008_C);
    vehicle_dates(2008, 2008, 30, 10, 8, PROP_epl9t_type2008_c_CF)
    vehicle_emu_wagon(ac, PROP_epl9t_type2008_c_WT, PROP_epl9t_type2008_c_CC, 3 * DOUBLE_DOOR, )
    vehicle_group_mu(group_epl9t)
  }
  graphics {
  purchase_menu_wagon(PROP_epl9t_type2008_c_CF, PROP_epl9t_type2008_c_RC, PROP_epl9t_type2008_c_SD, PROP_epl9t_type2008_c_WT, PROP_epl9t_type2008_c_TE, PROP_epl9t_type2008_c_PR, PROP_epl9t_type2008_c_CC)
        additional_text: epl9t_type2008_c_additional_text;
       articulated_part: articulated_part_dummy7;
       can_attach_wagon: epl9t_can_attach_wagon;
       cargo_age_period: return get_CAP_in_cb(CAP_00033_VERY_FAST);
         cargo_capacity: epl9t_type2008_c_cargo_capacity;
         colour_mapping: any_cc_colour;
                default: epl9t_type2008_c_sprites;
                   name: epl9t_type2008_c_name;
                  power: return 0;
               purchase: epl9t_type2008_c_purchase_sprites;
    running_cost_factor: epl9t_type2008_c_running_cost_factor;
                  speed: speed_after30_130to110;
             start_stop: return string(STR_START_STOP_HEAD_REQUIRED);
  }
}

long_name_template(epl9t_type2008_c, STR_LONGNAME_EPL9T_TYPE2008_C)
allow_acemu(epl9t_type2008_c)
