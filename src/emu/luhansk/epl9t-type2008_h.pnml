#define PROP_epl9t_type2008_n_RC  0
#define PROP_epl9t_type2008_n_SD  0
#define PROP_epl9t_type2008_n_WT  0
#define PROP_epl9t_type2008_n_TE  0
#define PROP_epl9t_type2008_n_PR  0
#define PROP_epl9t_type2008_n_CC  0

#define IMAGEFILE  "src/emu/luhansk/epl9t-type2008_h.png"
purchase_sprites_with_icon(epl9t_type2008_h, 18, 0, 25ac)
MU_head_sprites(15, epl9t_type2008_h_mu, 32, 40)
#undef IMAGEFILE
map_sprites(epl9t_type2008_purchase_sprites, epl9t_type2008_h_purchase_sprites)

MU_power_template2(epl9t_type2008_h, epl9t_h, epl9t_type2008_h)
engine_direction_template4m2(epl9t_type2008_h, epl9t_h, epl9t_type2008_h,  epl9t_m, epl9t_c)
MU_attach_wagon_icon_template2_only(epl9t_type2008_h, epl9t_h, epl9t_type2008_h, type_head, type_car_motor_pant_add_mandatory)
long_vehicle_advanced(epl9t_type2008_h, epl9t_type2008_h_sprites_start_sp)

engine_capacity_MU2(epl9t_type2008_h, PROP_epl9t_type2008_h_CC, epl9t_h, epl9t_type2008_h)

RC_head_check2(epl9t_type2008_h, epl9t_h, epl9t_type2008_h)
switch (FEAT_TRAINS, SELF, epl9t_type2008_h_running_cost_factor,
[  STORE_TEMP(38, 0),  // Моторы
   STORE_TEMP(0, 1),   // Бригада
   STORE_TEMP(13, 2),  // Износ
   STORE_TEMP(0, 3),   // Сопровождение
   STORE_TEMP(9, 4),   // ТО
   STORE_TEMP(1, 5),   // Сертификация

   STORE_TEMP(PROP_epl9t_type2008_h_SD, 6),                                          // Скорость
   STORE_TEMP(round(PROP_epl9t_type2008_h_WT), 7),                                   // Тара
   STORE_TEMP(round(PROP_epl9t_type2008_h_WT + PROP_epl9t_type2008_h_CC / 16), 8)])  // Максимальная масса
{ epl9t_type2008_h_check_running_cost_factor; }                                      // 66

name_in_group(epl9t_type2008_h, string(STR_NAME_IN_GROUP, string(STR_NAME_EPL9T_SERIES), string(STR_NAME_EPL9T_TYPE2008_H)),
                                string(STR_NAME_IN_GROUP, string(STR_NAME_EPL9T_SERIES), string(STR_LONGNAME_EPL9T_TYPE2008_H)))

hint_MU_in(epl9t_type2008_h,
     calc_loading(PROP_epl9t_type2008_h_CC / (2 * DOUBLE_DOOR)),
     STR_PURCHASE_HINT_CAP_00033_VERY_FAST,
     STR_PURCHASE_HINT_ENGINE_TYPE_EMU_H_AC,
     STR_SECTIONS_EMU_4_6_8_10_12,
     2008,
     fact_rigacw())
map_sprites(epl9t_type2008_additional_text, epl9t_type2008_h_additional_text)

item (FEAT_TRAINS, epl9t_type2008_h, 1316) {
  property {
    name: string(STR_NAME_EPL9T_TYPE2008_H);
    vehicle_dates(2008, 2008, 30, 10, 8, PROP_epl9t_type2008_h_CF)
    vehicle_emu_c(ac, PROP_epl9t_type2008_h_WT, PROP_epl9t_type2008_h_CC, 2 * DOUBLE_DOOR, )
    vehicle_group(group_epl9t)
  }
  graphics {
  purchase_menu(PROP_epl9t_type2008_h_CF, PROP_epl9t_type2008_h_RC, PROP_epl9t_type2008_h_SD, PROP_epl9t_type2008_h_WT, PROP_epl9t_type2008_h_TE, PROP_epl9t_type2008_h_PR, PROP_epl9t_type2008_h_CC)
        additional_text: epl9t_type2008_h_additional_text;
       articulated_part: articulated_part_dummy7;
       can_attach_wagon: epl9t_can_attach_wagon;
       cargo_age_period: return CAP_00033_VERY_FAST;
         cargo_capacity: epl9t_type2008_h_cargo_capacity;
         colour_mapping: any_cc_colour;
                default: epl9t_type2008_h_sprites;
                   name: epl9t_type2008_h_name;
                  power: return 0;
               purchase: epl9t_type2008_h_purchase_sprites;
    running_cost_factor: epl9t_type2008_h_running_cost_factor;
                  speed: speed_after30_130to110;
             start_stop: epl9t_h_start_stop;
  }
}

long_name_template(epl9t_type2008_h, STR_LONGNAME_EPL9T_TYPE2008_H)
allow_acemu(epl9t_type2008_h)
