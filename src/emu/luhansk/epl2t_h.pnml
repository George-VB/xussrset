// epl2t

#define PROP_epl2t_h_num  2
#define PROP_epl2t_n_num  0
#define PROP_epl2t_m_num  4
#define PROP_epl2t_c_num  2

#define PROP_epl2t_h_CF  9
#define PROP_epl2t_h_RC  66
#define PROP_epl2t_h_SD  130
#define PROP_epl2t_h_WT  51
#define PROP_epl2t_h_TE  0
#define PROP_epl2t_h_PR  0
#define PROP_epl2t_h_CC  118

#define PROP_epl2t_n_CF  0
#define PROP_epl2t_n_RC  0
#define PROP_epl2t_n_SD  0
#define PROP_epl2t_n_WT  0
#define PROP_epl2t_n_TE  0
#define PROP_epl2t_n_PR  0
#define PROP_epl2t_n_CC  0

#define IMAGEFILE  "src/emu/luhansk/epl2t_h.png"
purchase_sprites_with_icon(epl2t_h, 18, 0, 3dc)
MU_head_sprites(15, epl2t_h_v1_mu, 32, 40)
MU_head_sprites(15, epl2t_h_v2_mu, 32, 308)
MU_head_sprites(15, epl2t_h_v3_mu, 32, 576)
#undef IMAGEFILE

map_sprites(epl2t_purchase_sprites, epl2t_h_purchase_sprites)

MU_power_template2(epl2t_h_v1, epl2t_h, epl2t_type2006_h)
MU_power_template2(epl2t_h_v2, epl2t_h, epl2t_type2006_h)
MU_power_template2(epl2t_h_v3, epl2t_h, epl2t_type2006_h)

switch (FEAT_TRAINS, SELF, epl2t_h_sprites_left,
  cargo_subtype)
{
                   0: epl2t_h_v1_sprites_left;
  LV_UZ_CITY_EXPRESS: epl2t_h_v2_sprites_left;
  LV_DONETSK_RAILWAY: epl2t_h_v3_sprites_left;
  align_15_sprites;
}

switch (FEAT_TRAINS, SELF, epl2t_h_sprites_right,
  cargo_subtype)
{
                   0: epl2t_h_v1_sprites_right;
  LV_UZ_CITY_EXPRESS: epl2t_h_v2_sprites_right;
  LV_DONETSK_RAILWAY: epl2t_h_v3_sprites_right;
  align_15_sprites;
}

engine_direction_template4m2(epl2t_h, epl2t_h, epl2t_type2006_h, epl2t_m, epl2t_c)
MU_attach_wagon_icon_template2_only(epl2t_h, epl2t_h, epl2t_type2006_h, type_head, type_car_motor_pant_add_mandatory)
long_vehicle_advanced(epl2t_h, epl2t_h_sprites_start_sp)

EMU_4681012_can_attach_wagon_template(epl2t)
EMU_attach_calculation_template2h(epl2t, epl2t_h, epl2t_type2006_h, epl2t_m, epl2t_c)

switch (FEAT_TRAINS, SELF, epl2t_can_attach_wagon1,
  vehicle_type_id)
{
           epl2t_h: epl2t_can_attach_wagon_template;
  epl2t_type2006_h: epl2t_can_attach_wagon_template;
           epl2t_m: epl2t_can_attach_wagon_template;
           epl2t_c: epl2t_can_attach_wagon_template;
          return string(STR_CAN_ATTACH_SAME_MU_ONLY);
}

switch (FEAT_TRAINS, PARENT, epl2t_can_attach_wagon,
  count_veh_id(epl2t_h) + count_veh_id(epl2t_type2006_h))
{
  0: return string(STR_CAN_ATTACH_HEAD_ONLY);
  1: epl2t_can_attach_wagon1;
     return string(STR_CAN_ATTACH_NO_AFTER_REAR_HEAD);
}

livery_template_base_list2(epl2t, LV_UZ_CITY_EXPRESS, LV_DONETSK_RAILWAY)
MU_start_stop_template2_even(epl2t_h, epl2t_h, epl2t_type2006_h)
engine_capacity_MU2(epl2t_h, PROP_epl2t_h_CC, epl2t_h, epl2t_type2006_h)

RC_head_check2(epl2t_h, epl2t_h, epl2t_type2006_h)
switch (FEAT_TRAINS, SELF, epl2t_h_running_cost_factor,
[  STORE_TEMP(38, 0),  // Моторы
   STORE_TEMP(0, 1),   // Бригада
   STORE_TEMP(13, 2),  // Износ
   STORE_TEMP(0, 3),   // Сопровождение
   STORE_TEMP(9, 4),   // ТО
   STORE_TEMP(1, 5),   // Сертификация

   STORE_TEMP(PROP_epl2t_h_SD, 6),                                 // Скорость
   STORE_TEMP(round(PROP_epl2t_h_WT), 7),                          // Тара
   STORE_TEMP(round(PROP_epl2t_h_WT + PROP_epl2t_h_CC / 16), 8)])  // Максимальная масса
{ epl2t_h_check_running_cost_factor; }                             // 66

name_in_group(epl2t_h, string(STR_NAME_IN_GROUP, string(STR_NAME_EPL2T_SERIES), string(STR_NAME_EPL2T_H)),
                       string(STR_NAME_IN_GROUP, string(STR_NAME_EPL2T_SERIES), string(STR_LONGNAME_EPL2T_H)))

hint_MU(epl2t_h,
     calc_loading(PROP_epl2t_h_CC / (2 * DOUBLE_DOOR)),
     STR_PURCHASE_HINT_CAP_00033_VERY_FAST,
     STR_PURCHASE_HINT_ENGINE_TYPE_EMU_H_DC,
     STR_SECTIONS_EMU_4_6_8_10_12,
     2000, 2006,
     fact_rigacw())
map_sprites(epl2t_additional_text, epl2t_h_additional_text)

item (FEAT_TRAINS, epl2t_h, 1312) {
  property {
    name: string(STR_NAME_EPL2T_H);
    vehicle_dates(2000, 2006, 30, 10, 8, PROP_epl2t_h_CF)
    vehicle_emu_c(dc, PROP_epl2t_h_WT, PROP_epl2t_h_CC, 2 * DOUBLE_DOOR, )
    vehicle_group(group_epl2t)
  }
  graphics {
  purchase_menu(PROP_epl2t_h_CF, PROP_epl2t_h_RC, PROP_epl2t_h_SD, PROP_epl2t_h_WT, PROP_epl2t_h_TE, PROP_epl2t_h_PR, PROP_epl2t_h_CC)
        additional_text: epl2t_h_additional_text;
       articulated_part: articulated_part_dummy7;
       can_attach_wagon: epl2t_can_attach_wagon;
       cargo_age_period: return CAP_00033_VERY_FAST;
         cargo_capacity: epl2t_h_cargo_capacity;
     cargo_subtype_text: epl2t_cargo_subtype_text;
         colour_mapping: any_cc_colour;
                default: epl2t_h_sprites;
                   name: epl2t_h_name;
                  power: return 0;
               purchase: epl2t_h_purchase_sprites;
    running_cost_factor: epl2t_h_running_cost_factor;
                  speed: speed_after30_130to110;
             start_stop: epl2t_h_start_stop;
  }
}

long_name_template(epl2t_h, STR_LONGNAME_EPL2T_H)
allow_dcemu(epl2t_h)
