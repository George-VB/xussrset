// epl2t

#define PROP_epl2t_c_CF  6
#define PROP_epl2t_c_RC  45
#define PROP_epl2t_c_SD  130
#define PROP_epl2t_c_WT  49
#define PROP_epl2t_c_TE  0
#define PROP_epl2t_c_PR  0
#define PROP_epl2t_c_CC  136

#define IMAGEFILE  "src/emu/luhansk/epl2t_c.png"
purchase_sprites_with_icon(epl2t_c, 18, 0, 3dc)
MU_car_sprites(15, epl2t_c_v1_mu, 32, 40)
MU_car_sprites(15, epl2t_c_v2_mu, 32, 308)
MU_car_sprites(15, epl2t_c_v3_mu, 32, 576)
#undef IMAGEFILE

MU_power_dir_template2(epl2t_c_v1, epl2t_h, epl2t_type2006_h)
MU_power_dir_template2(epl2t_c_v2, epl2t_h, epl2t_type2006_h)
MU_power_dir_template2(epl2t_c_v3, epl2t_h, epl2t_type2006_h)

switch (FEAT_TRAINS, SELF, epl2t_c_direction_left,
  cargo_subtype)
{
                   0: epl2t_c_v1_direction_left;
  LV_UZ_CITY_EXPRESS: epl2t_c_v2_direction_left;
  LV_DONETSK_RAILWAY: epl2t_c_v3_direction_left;
  align_15_sprites;
}

switch (FEAT_TRAINS, SELF, epl2t_c_direction_right,
  cargo_subtype)
{
                   0: epl2t_c_v1_direction_right;
  LV_UZ_CITY_EXPRESS: epl2t_c_v2_direction_right;
  LV_DONETSK_RAILWAY: epl2t_c_v3_direction_right;
  align_15_sprites;
}

EMU_4_12_c_template(epl2t)
EMU_direction_calculation_template2h(epl2t_c, epl2t_h, epl2t_type2006_h, epl2t_m, epl2t_c)
EMU_4681012_attach_wagon_icon_template(epl2t_c)
EMU_attach_calculation_template2h(epl2t_c_next, epl2t_h, epl2t_type2006_h, epl2t_m, epl2t_c)
MU_attach_wagon_icon_template2(epl2t_c, epl2t_h, epl2t_type2006_h, type_car)
long_vehicle_advanced(epl2t_c, epl2t_c_sprites_start_sp)

engine_capacity_MU2(epl2t_c, PROP_epl2t_c_CC, epl2t_h, epl2t_type2006_h)

RC_head_check2(epl2t_c, epl2t_h, epl2t_type2006_h)
switch (FEAT_TRAINS, SELF, epl2t_c_running_cost_factor,
[  STORE_TEMP(26, 0),  // Моторы
   STORE_TEMP(0, 1),   // Бригада
   STORE_TEMP(9, 2),   // Износ
   STORE_TEMP(0, 3),   // Сопровождение
   STORE_TEMP(6, 4),   // ТО
   STORE_TEMP(0, 5),   // Сертификация

   STORE_TEMP(PROP_epl2t_c_SD, 6),                                 // Скорость
   STORE_TEMP(round(PROP_epl2t_c_WT), 7),                          // Тара
   STORE_TEMP(round(PROP_epl2t_c_WT + PROP_epl2t_c_CC / 16), 8)])  // Максимальная масса
{ epl2t_c_check_running_cost_factor; }                             // 45

name_in_group(epl2t_c, string(STR_NAME_IN_GROUP, string(STR_NAME_EPL2T_SERIES), string(STR_NAME_EPL2T_C)),
                       string(STR_NAME_IN_GROUP, string(STR_NAME_EPL2T_SERIES), string(STR_LONGNAME_EPL2T_C)))

hint_MU(epl2t_c,
     calc_loading(PROP_epl2t_c_CC / (3 * DOUBLE_DOOR)),
     STR_PURCHASE_HINT_CAP_00033_VERY_FAST,
     STR_PURCHASE_HINT_ENGINE_TYPE_EMU_C_DC,
     STR_SECTIONS_EMU_4_6_8_10_12,
     2000, 2008,
     fact_rigacw())

item (FEAT_TRAINS, epl2t_c, 1314) {
  property {
    name: string(STR_NAME_EPL2T_C);
    vehicle_dates(2000, 2008, 30, 10, 8, PROP_epl2t_c_CF)
    vehicle_emu_wagon(dc, PROP_epl2t_c_WT, PROP_epl2t_c_CC, 3 * DOUBLE_DOOR, )
    vehicle_group_mu(group_epl2t)
  }
  graphics {
  purchase_menu_wagon(PROP_epl2t_c_CF, PROP_epl2t_c_RC, PROP_epl2t_c_SD, PROP_epl2t_c_WT, PROP_epl2t_c_TE, PROP_epl2t_c_PR, PROP_epl2t_c_CC)
        additional_text: epl2t_c_additional_text;
       articulated_part: articulated_part_dummy7;
       can_attach_wagon: epl2t_can_attach_wagon;
       cargo_age_period: return CAP_00033_VERY_FAST;
         cargo_capacity: epl2t_c_cargo_capacity;
     cargo_subtype_text: epl2t_cargo_subtype_text;
         colour_mapping: any_cc_colour;
                default: epl2t_c_sprites;
                   name: epl2t_c_name;
                  power: return 0;
               purchase: epl2t_c_purchase_sprites;
    running_cost_factor: epl2t_c_running_cost_factor;
                  speed: speed_after30_130to110;
             start_stop: return string(STR_START_STOP_HEAD_REQUIRED);
  }
}

long_name_template(epl2t_c, STR_LONGNAME_EPL2T_C)
allow_dcemu(epl2t_c)
