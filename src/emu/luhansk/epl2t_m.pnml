// epl2t

#define PROP_epl2t_m_CF  15
#define PROP_epl2t_m_RC  108
#define PROP_epl2t_m_SD  130
#define PROP_epl2t_m_WT  65
#define PROP_epl2t_m_TE  93.4
#define PROP_epl2t_m_PR  kw2hp(880)
#define PROP_epl2t_m_CC  130

#define IMAGEFILE  "src/emu/luhansk/epl2t_m.png"
purchase_sprites_with_icon(epl2t_m, 18, 0, 3dc)
EMU_motor1_sprites(15, epl2t_m_v1_mu, 32, 40)
EMU_motor1_sprites(15, epl2t_m_v2_mu, 32, 308)
EMU_motor1_sprites(15, epl2t_m_v3_mu, 32, 576)
#undef IMAGEFILE

MU_power_dir_template2(epl2t_m_v1, epl2t_h, epl2t_type2006_h)
MU_power_dir_template2(epl2t_m_v2, epl2t_h, epl2t_type2006_h)
MU_power_dir_template2(epl2t_m_v3, epl2t_h, epl2t_type2006_h)

switch (FEAT_TRAINS, SELF, epl2t_m_direction_left,
  cargo_subtype)
{
                   0: epl2t_m_v1_direction_left;
  LV_UZ_CITY_EXPRESS: epl2t_m_v2_direction_left;
  LV_DONETSK_RAILWAY: epl2t_m_v3_direction_left;
  align_15_sprites;
}

switch (FEAT_TRAINS, SELF, epl2t_m_direction_right,
  cargo_subtype)
{
                   0: epl2t_m_v1_direction_right;
  LV_UZ_CITY_EXPRESS: epl2t_m_v2_direction_right;
  LV_DONETSK_RAILWAY: epl2t_m_v3_direction_right;
  align_15_sprites;
}

EMU_4_12_m_template(epl2t)
EMU_direction_calculation_template2set(epl2t_m, epl2t_h, epl2t_m, epl2t_c, epl2t_type2006_h, epl2t_m, epl2t_c)
EMU_4681012_attach_wagon_icon_template(epl2t_m)
EMU_attach_calculation_template2set(epl2t_m_next, epl2t_h, epl2t_m, epl2t_c, epl2t_type2006_h, epl2t_m, epl2t_c)
MU_attach_wagon_icon_template2(epl2t_m, epl2t_h, epl2t_type2006_h, type_car_motor_pant)
long_vehicle_advanced(epl2t_m, epl2t_m_sprites_start_sp)

EMU_4_12_m_create_effect_template(epl2t, -1, 5)
EMU_direction_calculation_template2set(epl2t_m_create_effect, epl2t_h, epl2t_m, epl2t_c, epl2t_type2006_h, epl2t_m, epl2t_c)
engine_effects_MU2(epl2t_m, _create_effect_direction_template, epl2t_h, epl2t_type2006_h)
engine_power_MU2(epl2t_m, PROP_epl2t_m_PR, epl2t_h, epl2t_type2006_h)
engine_capacity_MU2(epl2t_m, PROP_epl2t_m_CC, epl2t_h, epl2t_type2006_h)

RC_head_check2(epl2t_m, epl2t_h, epl2t_type2006_h)
switch (FEAT_TRAINS, SELF, epl2t_m_running_cost_factor,
[  STORE_TEMP(62, 0),  // Моторы
   STORE_TEMP(9, 1),   // Бригада
   STORE_TEMP(22, 2),  // Износ
   STORE_TEMP(0, 3),   // Сопровождение
   STORE_TEMP(15, 4),  // ТО
   STORE_TEMP(1, 5),   // Сертификация

   STORE_TEMP(PROP_epl2t_m_SD, 6),                                 // Скорость
   STORE_TEMP(round(PROP_epl2t_m_WT), 7),                          // Тара
   STORE_TEMP(round(PROP_epl2t_m_WT + PROP_epl2t_m_CC / 16), 8)])  // Максимальная масса
{ epl2t_m_check_running_cost_factor; }                             // 108

name_in_group(epl2t_m, string(STR_NAME_IN_GROUP, string(STR_NAME_EPL2T_SERIES), string(STR_NAME_EPL2T_M)),
                       string(STR_NAME_IN_GROUP, string(STR_NAME_EPL2T_SERIES), string(STR_LONGNAME_EPL2T_M)))

hint_MU_PTE(epl2t_m,
     calc_loading(PROP_epl2t_m_CC / (3 * DOUBLE_DOOR)),
     STR_PURCHASE_HINT_CAP_00033_VERY_FAST,
     STR_PURCHASE_HINT_ENGINE_TYPE_EMU_MP_DC,
     STR_SECTIONS_EMU_4_6_8_10_12,
     2000, 2008,
     fact_rigacw(),
     string(STR_NAME_EPL2T), PROP_epl2t_m_PR, PROP_epl2t_m_TE)

item (FEAT_TRAINS, epl2t_m, 1313) {
  property {
    name: string(STR_NAME_EPL2T_M);
    vehicle_dates(2000, 2008, 30, 10, 8, PROP_epl2t_m_CF)
    vehicle_emu_wagon(dc, PROP_epl2t_m_WT, PROP_epl2t_m_CC, 3 * DOUBLE_DOOR, )
    vehicle_group_mu(group_epl2t)
  }
  graphics {
  purchase_menu_wagon(PROP_epl2t_m_CF, PROP_epl2t_m_RC, PROP_epl2t_m_SD, PROP_epl2t_m_WT, PROP_epl2t_m_TE, PROP_epl2t_m_PR, PROP_epl2t_m_CC)
                additional_text: epl2t_m_additional_text;
               articulated_part: articulated_part_dummy7;
               can_attach_wagon: epl2t_can_attach_wagon;
               cargo_age_period: return CAP_00033_VERY_FAST;
                 cargo_capacity: epl2t_m_cargo_capacity;
             cargo_subtype_text: epl2t_cargo_subtype_text;
                 colour_mapping: any_cc_colour;
                  create_effect: epl2t_m_create_effect;
                        default: epl2t_m_sprites;
                           name: epl2t_m_name;
                          power: epl2t_m_power;
                       purchase: epl2t_m_purchase_sprites;
            running_cost_factor: epl2t_m_running_cost_factor;
                          speed: speed_after30_130to110;
                     start_stop: return string(STR_START_STOP_HEAD_REQUIRED);
    tractive_effort_coefficient: return get_tec_int(PROP_epl2t_m_TE, PROP_epl2t_m_WT);
  }
}

long_name_template(epl2t_m, STR_LONGNAME_EPL2T_M)
allow_dcemu(epl2t_m)
