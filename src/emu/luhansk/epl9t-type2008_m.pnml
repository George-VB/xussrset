// epl9t

#define PROP_epl9t_type2008_m_CF  2 * 15
#define PROP_epl9t_type2008_m_RC  108
#define PROP_epl9t_type2008_m_SD  130
#define PROP_epl9t_type2008_m_WT  65
#define PROP_epl9t_type2008_m_TE  93.4
#define PROP_epl9t_type2008_m_PR  kw2hp(880)
#define PROP_epl9t_type2008_m_CC  118

#define IMAGEFILE  "src/emu/luhansk/epl9t-type2008_m.png"
purchase_sprites_with_icon(epl9t_type2008_m, 18, 0, 25ac)
EMU_motor1_sprites(15, epl9t_type2008_m_mu, 32, 40)
#undef IMAGEFILE

MU_power_dir_template2(epl9t_type2008_m, epl9t_h, epl9t_type2008_h)
EMU_4_12_m_template(epl9t_type2008)
EMU_direction_calculation_template2set(epl9t_type2008_m, epl9t_h, epl9t_m, epl9t_c, epl9t_type2008_h, epl9t_type2008_m, epl9t_type2008_c)
EMU_4681012_attach_wagon_icon_template(epl9t_type2008_m)
EMU_attach_calculation_template2set(epl9t_type2008_m_next, epl9t_h, epl9t_m, epl9t_c, epl9t_type2008_h, epl9t_type2008_m, epl9t_type2008_c)
MU_attach_wagon_icon_template2(epl9t_type2008_m, epl9t_h, epl9t_type2008_h, type_car_motor_pant)
long_vehicle_advanced(epl9t_type2008_m, epl9t_type2008_m_sprites_start_sp)

EMU_4_12_m_create_effect_template(epl9t_type2008, -1, 5)
EMU_direction_calculation_template2set(epl9t_type2008_m_create_effect, epl9t_h, epl9t_m, epl9t_c, epl9t_type2008_h, epl9t_type2008_m, epl9t_type2008_c)
engine_effects_MU(epl9t_type2008_m, _create_effect_direction_template, epl9t_h)
engine_power_MU2(epl9t_type2008_m, PROP_epl9t_type2008_m_PR, epl9t_h, epl9t_type2008_h)
engine_capacity_MU2(epl9t_type2008_m, PROP_epl9t_type2008_m_CC, epl9t_h, epl9t_type2008_h)

RC_head_check2(epl9t_type2008_m, epl9t_h, epl9t_type2008_h)
switch (FEAT_TRAINS, SELF, epl9t_type2008_m_running_cost_factor,
[  STORE_TEMP(62, 0),  // Моторы
   STORE_TEMP(9, 1),   // Бригада
   STORE_TEMP(22, 2),  // Износ
   STORE_TEMP(0, 3),   // Сопровождение
   STORE_TEMP(15, 4),  // ТО
   STORE_TEMP(1, 5),   // Сертификация

   STORE_TEMP(PROP_epl9t_type2008_m_SD, 6),                                          // Скорость
   STORE_TEMP(round(PROP_epl9t_type2008_m_WT), 7),                                   // Тара
   STORE_TEMP(round(PROP_epl9t_type2008_m_WT + PROP_epl9t_type2008_m_CC / 16), 8)])  // Максимальная масса
{ epl9t_type2008_m_check_running_cost_factor; }                                      // 108

name_in_group(epl9t_type2008_m, string(STR_NAME_IN_GROUP, string(STR_NAME_EPL9T_SERIES), string(STR_NAME_EPL9T_TYPE2008_M)),
                                string(STR_NAME_IN_GROUP, string(STR_NAME_EPL9T_SERIES), string(STR_LONGNAME_EPL9T_TYPE2008_M)))

hint_MU_in_PTE(epl9t_type2008_m,
     calc_loading(PROP_epl9t_type2008_m_CC / (3 * DOUBLE_DOOR)),
     STR_PURCHASE_HINT_CAP_00033_VERY_FAST,
     STR_PURCHASE_HINT_ENGINE_TYPE_EMU_MP_AC,
     STR_SECTIONS_EMU_4_6_8_10_12,
     2008,
     fact_luhansk(),
     string(STR_NAME_EPL9T), PROP_epl9t_type2008_m_PR, PROP_epl9t_type2008_m_TE)

item (FEAT_TRAINS, epl9t_type2008_m, 1317) {
  property {
    name: string(STR_NAME_EPL9T_TYPE2008_M);
    vehicle_dates(2008, 2008, 30, 10, 8, PROP_epl9t_type2008_m_CF)
    vehicle_emu_wagon(ac, PROP_epl9t_type2008_m_WT, PROP_epl9t_type2008_m_CC, 3 * DOUBLE_DOOR, )
    vehicle_group_mu(group_epl9t)
  }
  graphics {
  purchase_menu_wagon(PROP_epl9t_type2008_m_CF, PROP_epl9t_type2008_m_RC, PROP_epl9t_type2008_m_SD, PROP_epl9t_type2008_m_WT, PROP_epl9t_type2008_m_TE, PROP_epl9t_type2008_m_PR, PROP_epl9t_type2008_m_CC)
                additional_text: epl9t_type2008_m_additional_text;
               articulated_part: articulated_part_dummy7;
               can_attach_wagon: epl9t_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_00033_VERY_FAST);
                 cargo_capacity: epl9t_type2008_m_cargo_capacity;
                 colour_mapping: any_cc_colour;
                  create_effect: epl9t_type2008_m_create_effect;
                        default: epl9t_type2008_m_sprites;
                           name: epl9t_type2008_m_name;
                          power: epl9t_type2008_m_power;
                       purchase: epl9t_type2008_m_purchase_sprites;
            running_cost_factor: epl9t_type2008_m_running_cost_factor;
                          speed: speed_after30_130to110;
                     start_stop: return string(STR_START_STOP_HEAD_REQUIRED);
    tractive_effort_coefficient: return get_tec_int(PROP_epl9t_type2008_m_TE, PROP_epl9t_type2008_m_WT);
  }
}

long_name_template(epl9t_type2008_m, STR_LONGNAME_EPL9T_TYPE2008_M)
allow_acemu(epl9t_type2008_m)
