}

item(FEAT_STATIONS, platform_high_left) {
  property {
        class: "HPLT";
    classname: string(STR_STATION_CLASSNAME_PLATFORM_HIGH);
         name: string(STR_STATION_NAME_PLATFORM_HIGH_LEFT);
  }
  graphics {
    sprite_layouts: [platform_X_nw, platform_Y_ne];
  }
}

item(FEAT_STATIONS, platform_high_right) {
  property {
        class: "HPLT";
         name: string(STR_STATION_NAME_PLATFORM_HIGH_RIGHT);
  }
  graphics {
    sprite_layouts: [platform_X_se, platform_Y_sw];
  }
}

item(FEAT_STATIONS, platform_high_all) {
