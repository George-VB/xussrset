#define IMAGEFILE  "src/rails/stations/platforms.png"
spriteset(platform_nw, IMAGEFILE)
{ abstract_template(80*0, 0, 64, 105, -31, -74) }
spriteset(platform_se, IMAGEFILE)
{ abstract_template(80*1, 0, 64, 105, -63+8, -74-4-8) }
spriteset(platform_ne, IMAGEFILE)
{ abstract_template(80*2, 0, 64, 105, -31, -74) }
spriteset(platform_sw, IMAGEFILE)
{ abstract_template(80*3, 0, 64, 105, -7, -74-4-8) }
#undef IMAGEFILE

spritelayout platform_X_nw {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 16;
          yextent: 4;
          zextent: 4;
      always_draw: 1;
           sprite: platform_nw;
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

spritelayout platform_X_se {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  building {
          xoffset: 0;
          yoffset: 12;
          zoffset: 0;
          xextent: 16;
          yextent: 4;
          zextent: 4;
           sprite: platform_se;
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

spritelayout platform_X_all {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 16;
          yextent: 4;
          zextent: 4;
           sprite: platform_nw;
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 0;
          yoffset: 12;
          zoffset: 0;
          xextent: 16;
          yextent: 4;
          zextent: 4;
           sprite: platform_se;
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

spritelayout platform_Y_ne {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 16;
          zextent: 4;
           sprite: platform_ne;
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

spritelayout platform_Y_sw {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
  }
  building {
          xoffset: 12;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 16;
          zextent: 4;
           sprite: platform_sw;
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

spritelayout platform_Y_all {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 16;
          zextent: 4;
           sprite: platform_ne;
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 12;
          yoffset: 0;
          zoffset: 0;
