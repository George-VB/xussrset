#define check_station_id(off_len, off_plat, stat_id)        \
((nearby_tile_is_station(off_len, off_plat) == 1) &&        \
 (nearby_tile_station_id(off_len, off_plat) == stat_id) &&  \
 (nearby_tile_perpendicular(off_len, off_plat) == 1))       \
/*
 &&  \
 (nearby_tile_same_grf(off_len, off_plat) == 1)
 */
#define SPRITES_PER_ROW 10

spritelayout crossing_pedastrian_X {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  childsprite {
    sprite: crossing(0 +
                     check_station_id(-1,0, low_platform_all) * SPRITES_PER_ROW +
                     check_station_id(-1,0, low_platform_left) * SPRITES_PER_ROW +
                     check_station_id(1,0, low_platform_all) * SPRITES_PER_ROW * 2 +
                     check_station_id(1,0, low_platform_left) * SPRITES_PER_ROW * 2 +
                     check_station_id(-1,0, low_platform_all) * SPRITES_PER_ROW * 4 +
                     check_station_id(-1,0, low_platform_right) * SPRITES_PER_ROW * 4 +
                     check_station_id(1,0, low_platform_all) * SPRITES_PER_ROW * 8 +
                     check_station_id(1,0, low_platform_right) * SPRITES_PER_ROW * 8 +

                     check_station_id(0,-1, crossing_pedastrian) * 2 +
                     check_station_id(0,1, crossing_pedastrian) * 4
                     );
    always_draw: 1;
  }
  childsprite {
    sprite: crossing(8 +
                     ((! (check_station_id(-1,-1, low_platform_all) || check_station_id(-1,-1, low_platform_right))) &&
                         (check_station_id(-1,0, low_platform_all)  || check_station_id(-1,0, low_platform_left)) ) * SPRITES_PER_ROW +
                     ((! (check_station_id(1,-1, low_platform_all)  || check_station_id(1,-1, low_platform_right))) &&
                         (check_station_id(1,0, low_platform_all)   || check_station_id(1,0, low_platform_left)) ) * SPRITES_PER_ROW * 2 +
                     ((! (check_station_id(-1,1, low_platform_all)  || check_station_id(-1,1, low_platform_left))) &&
                         (check_station_id(-1,0, low_platform_all)  || check_station_id(-1,0, low_platform_right)) ) * SPRITES_PER_ROW * 4 +
                     ((! (check_station_id(1,1, low_platform_all)   || check_station_id(1,1, low_platform_left))) &&
                         (check_station_id(1,0, low_platform_all)   || check_station_id(1,0, low_platform_right)) ) * SPRITES_PER_ROW * 8
                    );
    always_draw: 1;
  }
}
spritelayout crossing_pedastrian_Y {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
  }
  childsprite {
    sprite: crossing(1 +
                     check_station_id(-1,0, low_platform_all) * SPRITES_PER_ROW +
                     check_station_id(-1,0, low_platform_left) * SPRITES_PER_ROW +
                     check_station_id(1,0, low_platform_all) * SPRITES_PER_ROW * 2 +
                     check_station_id(1,0, low_platform_left) * SPRITES_PER_ROW * 2 +
                     check_station_id(-1,0, low_platform_all) * SPRITES_PER_ROW * 4 +
                     check_station_id(-1,0, low_platform_right) * SPRITES_PER_ROW * 4 +
                     check_station_id(1,0, low_platform_all) * SPRITES_PER_ROW * 8 +
                     check_station_id(1,0, low_platform_right) * SPRITES_PER_ROW * 8 +

                     check_station_id(0,-1, crossing_pedastrian) * 2 +
                     check_station_id(0,1, crossing_pedastrian) * 4
                     );
    always_draw: 1;
  }
  childsprite {
    sprite: crossing(9 +
                     ((! (check_station_id(-1,-1, low_platform_all) || check_station_id(-1,-1, low_platform_right))) &&
                         (check_station_id(-1,0, low_platform_all)  || check_station_id(-1,0, low_platform_left)) ) * SPRITES_PER_ROW +
                     ((! (check_station_id(1,-1, low_platform_all)  || check_station_id(1,-1, low_platform_right))) &&
                         (check_station_id(1,0, low_platform_all)   || check_station_id(1,0, low_platform_left)) ) * SPRITES_PER_ROW * 2 +
                     ((! (check_station_id(-1,1, low_platform_all)  || check_station_id(-1,1, low_platform_left))) &&
                         (check_station_id(-1,0, low_platform_all)  || check_station_id(-1,0, low_platform_right)) ) * SPRITES_PER_ROW * 4 +
                     ((! (check_station_id(1,1, low_platform_all)   || check_station_id(1,1, low_platform_left))) &&
                         (check_station_id(1,0, low_platform_all)   || check_station_id(1,0, low_platform_right)) ) * SPRITES_PER_ROW * 8
                    );
    always_draw: 1;
  }
}

item(FEAT_STATIONS, crossing_pedastrian) {
  property {
        class: "WAYP";
         name: string(STR_STATION_NAME_PLATFORM_LOW);
  }
  graphics {
    sprite_layouts: [crossing_pedastrian_X, crossing_pedastrian_Y];
  }
}
