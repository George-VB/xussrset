spriteset(platform_high_stairs, "src/rails/stations/platform-high-stairs.png")
{
  abstract_template(2 + 80*0, 2 + 49*0, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*0, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*0, 64, 47, -31+24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*0, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*1, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*1, 2 + 49*1, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*2, 2 + 49*1, 64, 47, -31,    -16-24)
  abstract_template(2 + 80*3, 2 + 49*1, 64, 47, -31,    -16-24)
}
#define SPRITES_PER_ROW_CROSSING_P 10

switch(FEAT_STATIONS, SELF, platform_low_nearby,
[ STORE_TEMP(
  check_station_id_non_perp(-1,0, platform_low_all) +
  check_station_id_non_perp(-1,0, platform_low_left) +
  check_station_id_non_perp(-1,0, platform_high_all) +
  check_station_id_non_perp(-1,0, platform_high_left) +
  check_station_id_non_perp(1,0, platform_low_all) * 2 +
  check_station_id_non_perp(1,0, platform_low_left) * 2 +
  check_station_id_non_perp(1,0, platform_high_all) * 2 +
  check_station_id_non_perp(1,0, platform_high_left) * 2 +
  check_station_id_non_perp(-1,0, platform_low_all) * 4 +
  check_station_id_non_perp(-1,0, platform_low_right) * 4 +
  check_station_id_non_perp(-1,0, platform_high_all) * 4 +
  check_station_id_non_perp(-1,0, platform_high_right) * 4 +
  check_station_id_non_perp(1,0, platform_low_all) * 8 +
  check_station_id_non_perp(1,0, platform_low_right) * 8 +
  check_station_id_non_perp(1,0, platform_high_all) * 8 +
  check_station_id_non_perp(1,0, platform_high_right) * 8, 0)] )
{ return; }

switch(FEAT_STATIONS, SELF, platform_low_diagonal,
[ STORE_TEMP(
  ((! (check_station_id_non_perp(-1,-1, platform_low_all) ||
       check_station_id_non_perp(-1,-1, platform_low_right) ||
       check_station_id_non_perp(-1,-1, platform_high_all) ||
       check_station_id_non_perp(-1,-1, platform_high_right) )) &&
      (check_station_id_non_perp(-1,0, platform_low_all) ||
       check_station_id_non_perp(-1,0, platform_low_left) ||
       check_station_id_non_perp(-1,0, platform_high_all) ||
       check_station_id_non_perp(-1,0, platform_high_left) ))  +
  ((! (check_station_id_non_perp(1,-1, platform_low_all) ||
       check_station_id_non_perp(1,-1, platform_low_right) ||
       check_station_id_non_perp(1,-1, platform_high_all) ||
       check_station_id_non_perp(1,-1, platform_high_right) )) &&
      (check_station_id_non_perp(1,0, platform_low_all) ||
       check_station_id_non_perp(1,0, platform_low_left) ||
       check_station_id_non_perp(1,0, platform_high_all) ||
       check_station_id_non_perp(1,0, platform_high_left) )) * 2 +
  ((! (check_station_id_non_perp(-1,1, platform_low_all) ||
       check_station_id_non_perp(-1,1, platform_low_left) ||
       check_station_id_non_perp(-1,1, platform_high_all) ||
       check_station_id_non_perp(-1,1, platform_high_left) )) &&
      (check_station_id_non_perp(-1,0, platform_low_all) ||
       check_station_id_non_perp(-1,0, platform_low_right) ||
       check_station_id_non_perp(-1,0, platform_high_all) ||
       check_station_id_non_perp(-1,0, platform_high_right) )) * 4 +
  ((! (check_station_id_non_perp(1,1, platform_low_all) ||
       check_station_id_non_perp(1,1, platform_low_left) ||
       check_station_id_non_perp(1,1, platform_high_all) ||
       check_station_id_non_perp(1,1, platform_high_left) )) &&
      (check_station_id_non_perp(1,0, platform_low_all) ||
       check_station_id_non_perp(1,0, platform_low_right) ||
       check_station_id_non_perp(1,0, platform_high_all) ||
       check_station_id_non_perp(1,0, platform_high_right) )) * 8, 1)] )
{ platform_low_nearby; }

switch(FEAT_STATIONS, SELF, platform_low_onside,
[ STORE_TEMP(
  check_station_id_non_perp(0,-1, crossing_pedastrian) +
  check_station_id_non_perp(0,1, crossing_pedastrian) * 2, 2)] )
{ platform_low_diagonal; }

switch(FEAT_STATIONS, SELF, calculate_crossing_pedastrian,
[ STORE_TEMP(
  check_station_id_non_perp(-1,0, platform_high_all) +
  check_station_id_non_perp(-1,0, platform_high_left) +
  check_station_id_non_perp(1,0, platform_high_all) * 2 +
  check_station_id_non_perp(1,0, platform_high_left) * 2 +
  check_station_id_non_perp(-1,0, platform_high_all) * 4 +
  check_station_id_non_perp(-1,0, platform_high_right) * 4 +
  check_station_id_non_perp(1,0, platform_high_all) * 8 +
  check_station_id_non_perp(1,0, platform_high_right) * 8, 3)] )
{ platform_low_onside; }

spritelayout crossing_pedastrian_X {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  childsprite {
         sprite: crossing(0 + LOAD_TEMP(0) * SPRITES_PER_ROW_CROSSING_P + LOAD_TEMP(2) * 2);
    always_draw: 1;
  }
  childsprite {
         sprite: crossing(8 + LOAD_TEMP(1) * SPRITES_PER_ROW_CROSSING_P);
    always_draw: 1;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x01) == 0x00;
           sprite: platform_high_stairs(0);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 12;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x02) == 0x00;
           sprite: platform_high_stairs(2);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 0;
          yoffset: 12;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x04) == 0x00;
           sprite: platform_high_stairs(4);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 12;
          yoffset: 12;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x08) == 0x00;
           sprite: platform_high_stairs(6);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

spritelayout crossing_pedastrian_Y {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
  }
  childsprite {
         sprite: crossing(1 + LOAD_TEMP(0) * SPRITES_PER_ROW_CROSSING_P + LOAD_TEMP(2) * 2);
    always_draw: 1;
  }
  childsprite {
         sprite: crossing(9 + LOAD_TEMP(1) * SPRITES_PER_ROW_CROSSING_P);
    always_draw: 1;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x01) == 0x00;
           sprite: platform_high_stairs(1);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 12;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x02) == 0x00;
           sprite: platform_high_stairs(3);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 0;
          yoffset: 12;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x04) == 0x00;
           sprite: platform_high_stairs(5);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 12;
          yoffset: 12;
          zoffset: 0;
          xextent: 4;
          yextent: 4;
          zextent: 8;
      always_draw: 0;
      hide_sprite: (LOAD_TEMP(3) & 0x08) == 0x00;
           sprite: platform_high_stairs(7);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

item(FEAT_STATIONS, crossing_pedastrian) {
  property {
        class: "WAYP";
         name: string(STR_STATION_NAME_CROSSING_PEDASTRIAN);
  }
  graphics {
    prepare_layout: calculate_crossing_pedastrian();
    sprite_layouts: [crossing_pedastrian_X, crossing_pedastrian_Y];
  }
}
