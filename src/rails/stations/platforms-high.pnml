  /// platforms

item(FEAT_STATIONS, platform_high) {
  property {
        class: "HPLT";
    classname: string(STR_STATION_CLASSNAME_PLATFORM_HIGH);
         name: string(STR_STATION_CLASSNAME_PLATFORM_HIGH);
  }
}


#define platforms(station_name, class_name, str, pngfilename)                                      \
spriteset(station_name##_nw, pngfilename) { abstract_template(80*0, 0, 64, 105, -31, -74) }        \
spriteset(station_name##_se, pngfilename) { abstract_template(80*1, 0, 64, 105, -63+8, -74-4-8) }  \
spriteset(station_name##_ne, pngfilename) { abstract_template(80*2, 0, 64, 105, -31, -74) }        \
spriteset(station_name##_sw, pngfilename) { abstract_template(80*3, 0, 64, 105, -7, -74-4-8) }     \
spritelayout station_name##_X_nw {                                                                 \
  ground {                                                                                         \
    sprite: GROUNDSPRITE_RAIL_X ;                                                                  \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 0;                                                                              \
          yoffset: 0;                                                                              \
          zoffset: 0;                                                                              \
          xextent: 16;                                                                             \
          yextent: 4;                                                                              \
          zextent: 4;                                                                              \
      always_draw: 1;                                                                              \
           sprite: station_name##_nw;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
spritelayout station_name##_X_se {                                                                 \
  ground {                                                                                         \
    sprite: GROUNDSPRITE_RAIL_X ;                                                                  \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 0;                                                                              \
          yoffset: 12;                                                                             \
          zoffset: 0;                                                                              \
          xextent: 16;                                                                             \
          yextent: 4;                                                                              \
          zextent: 4;                                                                              \
           sprite: station_name##_se;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
spritelayout station_name##_X_all {                                                                \
  ground {                                                                                         \
    sprite: GROUNDSPRITE_RAIL_X ;                                                                  \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 0;                                                                              \
          yoffset: 0;                                                                              \
          zoffset: 0;                                                                              \
          xextent: 16;                                                                             \
          yextent: 4;                                                                              \
          zextent: 4;                                                                              \
           sprite: station_name##_nw;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 0;                                                                              \
          yoffset: 12;                                                                             \
          zoffset: 0;                                                                              \
          xextent: 16;                                                                             \
          yextent: 4;                                                                              \
          zextent: 4;                                                                              \
           sprite: station_name##_se;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
spritelayout station_name##_Y_ne {                                                                 \
  ground {                                                                                         \
    sprite: GROUNDSPRITE_RAIL_Y ;                                                                  \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 0;                                                                              \
          yoffset: 0;                                                                              \
          zoffset: 0;                                                                              \
          xextent: 4;                                                                              \
          yextent: 16;                                                                             \
          zextent: 4;                                                                              \
           sprite: station_name##_ne;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
spritelayout station_name##_Y_sw {                                                                 \
  ground {                                                                                         \
    sprite: GROUNDSPRITE_RAIL_Y ;                                                                  \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 12;                                                                             \
          yoffset: 0;                                                                              \
          zoffset: 0;                                                                              \
          xextent: 4;                                                                              \
          yextent: 16;                                                                             \
          zextent: 4;                                                                              \
           sprite: station_name##_sw;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
spritelayout station_name##_Y_all {                                                                \
  ground {                                                                                         \
    sprite: GROUNDSPRITE_RAIL_Y ;                                                                  \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 0;                                                                              \
          yoffset: 0;                                                                              \
          zoffset: 0;                                                                              \
          xextent: 4;                                                                              \
          yextent: 16;                                                                             \
          zextent: 4;                                                                              \
           sprite: station_name##_ne;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
  building {                                                                                       \
          xoffset: 12;                                                                             \
          yoffset: 0;                                                                              \
          zoffset: 0;                                                                              \
          xextent: 4;                                                                              \
          yextent: 16;                                                                             \
          zextent: 4;                                                                              \
           sprite: station_name##_sw;                                                              \
    recolour_mode: RECOLOUR_REMAP;                                                                 \
          palette: PALETTE_USE_DEFAULT;                                                            \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
item(FEAT_STATIONS, station_name##_high_left) {                                                    \
  property {                                                                                       \
        class: class_name;                                                                         \
         name: string(str);                                                                        \
  }                                                                                                \
  graphics {                                                                                       \
    sprite_layouts: [station_name##_X_nw, station_name##_Y_ne];                                    \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
item(FEAT_STATIONS, station_name##_high_right) {                                                   \
  property {                                                                                       \
        class: class_name;                                                                         \
         name: string(str);                                                                        \
  }                                                                                                \
  graphics {                                                                                       \
    sprite_layouts: [station_name##_X_se, station_name##_Y_sw];                                    \
  }                                                                                                \
}                                                                                                  \
                                                                                                   \
item(FEAT_STATIONS, station_name##_high_all) {                                                     \
  property {                                                                                       \
        class: class_name;                                                                         \
         name: string(str);                                                                        \
  }                                                                                                \
  graphics {                                                                                       \
    sprite_layouts: [station_name##_X_all, station_name##_Y_all];                                  \
  }                                                                                                \
}                                                                                                  \

platforms(platform_empty,       "HPLT", STR_STATION_NAME_PLATFORM_HIGH,             "src/rails/stations/platform-empty.png")
platforms(platform_end,         "HPLT", STR_STATION_NAME_PLATFORM_HIGH_END,         "src/rails/stations/platform_end.png")
