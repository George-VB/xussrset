  /// double rail

spriteset(double_rails, "src/rails/stations/double-rail.png")
{
  abstract_template(2 + 80*0, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*1, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*2, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*3, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*4, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*5, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*6, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*7, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*8, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*9, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*10, 2 + 33*0, 64, 31, -31, 0)
  abstract_template(2 + 80*11, 2 + 33*0, 64, 31, -31, 0)

  abstract_template(       2,        2,  1,  1,   0, 0)
}
spriteset(double_rails_menu, "src/rails/stations/double-rail.png")
{
  abstract_template(2 + 80*12, 2 + 33*0, 64, 31, -31, 0)
}
#define MAX_SPRITE_DOUBLE_RAIL 12

/*
                            0
 Snail based              7   1
 numbering              6       2
 starting north           5   3
                            4
 TODO разобрать ситуацию, если сзади депо, а на диагонали двойные рельсы
*/

switch(FEAT_STATIONS, SELF, calculate_double_rail,
[ STORE_TEMP(
  (check_station_id_non_perp(-1,-1, double_rail) ||
   check_station_id_non_perp(-1,-1, depot) ) +
  (check_station_id_non_perp(-1,0, double_rail) ||
   check_station_id_non_perp(-1,0, depot) ) * 2 +
  (check_station_id_non_perp(-1,1, double_rail) ||
   check_station_id_non_perp(-1,1, depot) ) * 4 +
  (check_station_id_non_perp(0,1, double_rail) /* ||
   check_station_id_non_perp(0,1, depot) */ ) * 8 +
  (check_station_id_non_perp(1,1, double_rail) ||
   check_station_id_non_perp(1,1, depot) ) * 16 +
  (check_station_id_non_perp(1,0, double_rail) ||
   check_station_id_non_perp(1,0, depot) ) * 32 +
  (check_station_id_non_perp(1,-1, double_rail) ||
   check_station_id_non_perp(1,-1, depot) ) * 64 +
  (check_station_id_non_perp(0,-1, double_rail) /* ||
   check_station_id_non_perp(0,-1, depot) */ ) * 128, 0)] )
{ return; }

spritelayout double_rail_X {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  childsprite {
         sprite: double_rails(((LOAD_TEMP(0) & 0xE3) == 0xE3) ? 0  :
                              ((LOAD_TEMP(0) & 0x83) == 0x83) ? 4  :
                              ((LOAD_TEMP(0) & 0xE0) == 0xE0) ? 8  :
                              MAX_SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
  childsprite {
         sprite: double_rails(((LOAD_TEMP(0) & 0x3E) == 0x3E) ? 2   :
                              ((LOAD_TEMP(0) & 0x0E) == 0x0E) ? 6   :
                              ((LOAD_TEMP(0) & 0x38) == 0x38) ? 10  :
                              MAX_SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
}

spritelayout double_rail_Y {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
  }
  childsprite {
         sprite: double_rails(((LOAD_TEMP(0) & 0xE3) == 0xE3) ? 1  :
                              ((LOAD_TEMP(0) & 0x83) == 0x83) ? 5  :
                              ((LOAD_TEMP(0) & 0xE0) == 0xE0) ? 9  :
                              MAX_SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
  childsprite {
         sprite: double_rails(((LOAD_TEMP(0) & 0x3E) == 0x3E) ? 3   :
                              ((LOAD_TEMP(0) & 0x0E) == 0x0E) ? 7   :
                              ((LOAD_TEMP(0) & 0x38) == 0x38) ? 11  :
                              MAX_SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
}

item(FEAT_STATIONS, double_rail) {
  property {
        class: "WAYP";
         name: string(STR_STATION_NAME_DOUBLE_RAIL);
  }
  graphics {
    prepare_layout: calculate_double_rail();
          purchase: double_rails_menu;
    sprite_layouts: [double_rail_X, double_rail_Y];
  }
}
