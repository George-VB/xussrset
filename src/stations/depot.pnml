// Registers:
// 0 - depot on Back side / Front side
// 1 - rails on Back side / Front side (depot + rilas front)
// 2 - depot on Forvard
// 3 - purchase
// 4 - railtype

switch(FEAT_STATIONS, SELF, calculate_depot,
[ STORE_TEMP( (check_station_id_non_perp(0,-1, depot))  +
              (check_station_id_non_perp(0,1, depot)) * 2, 0),
  STORE_TEMP( ( ( (check_station_id_non_perp(1,-1, double_rail) &&
                   check_station_id_non_perp(1,0, double_rail) ) ||
                  (check_station_id_non_perp(1,-1, depot) &&
                   check_station_id_non_perp(1,0, depot) ) ) &&
                (check_station_id_non_perp(0,-1, depot) ) )  +
              ( ( (check_station_id_non_perp(1,1, double_rail) &&
                   check_station_id_non_perp(1,0, double_rail) ) ||
                  (check_station_id_non_perp(1,1, depot) &&
                   check_station_id_non_perp(1,0, depot) ) ) &&
                (check_station_id_non_perp(0,1, depot) ) ) * 2, 1),
  STORE_TEMP(check_station_id_non_perp(1,0, depot), 2),
  STORE_TEMP(0, 3) ] )
{ calculate_rail_type; }

switch(FEAT_STATIONS, SELF, calculate_depot_menu,
[ STORE_TEMP(0, 0),
  STORE_TEMP(0, 1),
  STORE_TEMP(0, 2),
  STORE_TEMP(1, 3) ] )
{ calculate_rail_type; }

spritelayout depot_X {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  childsprite {
    hide_sprite: (LOAD_TEMP(1) & 0x01) == 0x00;
         sprite: double_rails(0 + LOAD_TEMP(4) * SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
  childsprite {
    hide_sprite: (LOAD_TEMP(1) & 0x02) == 0x00;
         sprite: double_rails(2 + LOAD_TEMP(4) * SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
  building {  // menu
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 16;
          yextent: 16;
          zextent: 16;
      hide_sprite: ! LOAD_TEMP(3);
           sprite: depot_fronts(26);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {
      hide_sprite: ! LOAD_TEMP(3);
           sprite: depot_glasses(6);
    recolour_mode: RECOLOUR_TRANSPARENT;
          palette: PALETTE_TRANSPARENT;
  }
  building {  // back wall
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 16;
          yextent: 1;
          zextent: 16;
      hide_sprite: LOAD_TEMP(3) || (LOAD_TEMP(2) & ((LOAD_TEMP(0) & 0x01) == 0x01));
           sprite: depot_backs(LOAD_TEMP(2) ? 0                   :
                               (LOAD_TEMP(0) & 0x01) == 0x00 ? 2  :
                               (LOAD_TEMP(1) & 0x01) == 0x00 ? 4  : 6);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {  // fake door front
           xoffset: 8;
           yoffset: 7;
       hide_sprite: LOAD_TEMP(3) || LOAD_TEMP(2) || ((LOAD_TEMP(1) & 0x01) == 0x00);
            sprite: depot_doors(14);
     recolour_mode: RECOLOUR_REMAP;
           palette: PALETTE_USE_DEFAULT;
  }
  childsprite {  // real door back
          xoffset: 9;
          yoffset: 5 + ((LOAD_TEMP(0) & 0x01) == 0x00) * 18;
      hide_sprite: LOAD_TEMP(3) || LOAD_TEMP(2);
           sprite: depot_doors(animation_frame >= 10 ? - 5 + animation_frame  : 9 - animation_frame);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {  // front wall entrance
          xoffset: 0;
          yoffset: 15;
          zoffset: 0;
          xextent: 16;
          yextent: 1;
          zextent: 16;
      hide_sprite: LOAD_TEMP(3) || LOAD_TEMP(2);
           sprite: depot_fronts(LOAD_TEMP(0) == 0 ? 0                                        :
                                LOAD_TEMP(0) == 1 ? 2 + ((LOAD_TEMP(1) & 0x01) == 0x01) * 2  :
                                LOAD_TEMP(0) == 2 ? 6 + ((LOAD_TEMP(1) & 0x02) == 0x02) * 2  :
                                                    10 + LOAD_TEMP(1) * 2);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {
      hide_sprite: LOAD_TEMP(3) || LOAD_TEMP(2);
           sprite: depot_glasses(0 + LOAD_TEMP(0) * 2);
    recolour_mode: RECOLOUR_TRANSPARENT;
          palette: PALETTE_TRANSPARENT;
  }
  childsprite {  // real door front
          xoffset: 24;
          yoffset: 32;
      hide_sprite: LOAD_TEMP(3) || LOAD_TEMP(2);
           sprite: depot_doors(animation_frame >= 10 ? animation_frame  : 14 - animation_frame);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {  // fake door back
           xoffset: 25;
           yoffset: 30;
       hide_sprite: LOAD_TEMP(3) || LOAD_TEMP(2) || ((LOAD_TEMP(1) & 0x02) == 0x00);
            sprite: depot_doors(9);
     recolour_mode: RECOLOUR_REMAP;
           palette: PALETTE_USE_DEFAULT;
 }
 building {  // front wall body
          xoffset: 0;
          yoffset: 15;
          zoffset: 0;
          xextent: 16;
          yextent: 1;
          zextent: 16;
      hide_sprite: LOAD_TEMP(3) || (! LOAD_TEMP(2));
           sprite: depot_fronts(18 + LOAD_TEMP(0) * 2);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {
      hide_sprite: LOAD_TEMP(3) || (! LOAD_TEMP(2));
           sprite: depot_glasses(8 + LOAD_TEMP(0) * 2);
    recolour_mode: RECOLOUR_TRANSPARENT;
          palette: PALETTE_TRANSPARENT;
  }
}

spritelayout depot_Y {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
  }
  childsprite {
    hide_sprite: (LOAD_TEMP(1) & 0x01) == 0x00;
         sprite: double_rails(1 + LOAD_TEMP(4) * SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
  childsprite {
    hide_sprite: (LOAD_TEMP(1) & 0x02) == 0x00;
         sprite: double_rails(3 + LOAD_TEMP(4) * SPRITE_DOUBLE_RAIL);
    always_draw: 1;
  }
  building {  // back wall
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 1;
          yextent: 16;
          zextent: 16;
      hide_sprite: LOAD_TEMP(2) & ((LOAD_TEMP(0) & 0x01) == 0x01);
           sprite: depot_backs(LOAD_TEMP(2) ? 1                   :
                               (LOAD_TEMP(0) & 0x01) == 0x00 ? 3  :
                               (LOAD_TEMP(1) & 0x01) == 0x00 ? 5  : 7);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {  // fake door front
           xoffset: 15;
           yoffset: 07;
       hide_sprite: LOAD_TEMP(2) || ((LOAD_TEMP(1) & 0x01) == 0x00);
            sprite: depot_doors(0);
     recolour_mode: RECOLOUR_REMAP;
           palette: PALETTE_USE_DEFAULT;
  }
  childsprite {  // real door back
          xoffset: 0 + ((LOAD_TEMP(0) & 0x01) == 0x00) * 14;
          yoffset: 5 + ((LOAD_TEMP(0) & 0x01) == 0x00) * 18;
      hide_sprite: LOAD_TEMP(2);
           sprite: depot_doors(animation_frame >= 10 ? 19 - animation_frame  : 5 + animation_frame);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {  // front wall entrance
          xoffset: 15;
          yoffset: 0;
          zoffset: 0;
          xextent: 1;
          yextent: 16;
          zextent: 16;
      hide_sprite: LOAD_TEMP(2);
           sprite: depot_fronts(LOAD_TEMP(0) == 0 ? 1                                        :
                                LOAD_TEMP(0) == 1 ? 3 + ((LOAD_TEMP(1) & 0x01) == 0x01) * 2  :
                                LOAD_TEMP(0) == 2 ? 7 + ((LOAD_TEMP(1) & 0x02) == 0x02) * 2  :
                                                    11 + LOAD_TEMP(1) * 2);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {
      hide_sprite: LOAD_TEMP(2);
           sprite: depot_glasses(1 + LOAD_TEMP(0) * 2);
    recolour_mode: RECOLOUR_TRANSPARENT;
          palette: PALETTE_TRANSPARENT;
  }
  childsprite {  // real door front
          xoffset: 45;
          yoffset: 32;
           sprite: depot_doors(animation_frame >= 10 ? 14 - animation_frame  : animation_frame);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  childsprite {  // fake door back
           xoffset: 30;
           yoffset: 30;
       hide_sprite: LOAD_TEMP(2) || ((LOAD_TEMP(1) & 0x02) == 0x00);
            sprite: depot_doors(5);
     recolour_mode: RECOLOUR_REMAP;
           palette: PALETTE_USE_DEFAULT;
  }
  building {  // front wall body
           xoffset: 15;
           yoffset: 0;
           zoffset: 0;
           xextent: 1;
           yextent: 16;
           zextent: 16;
       hide_sprite: ! LOAD_TEMP(2);
            sprite: depot_fronts(19 + LOAD_TEMP(0) * 2);
     recolour_mode: RECOLOUR_REMAP;
           palette: PALETTE_USE_DEFAULT;
  }
  childsprite {
      hide_sprite: ! LOAD_TEMP(2);
           sprite: depot_glasses(9 + LOAD_TEMP(0) * 2);
    recolour_mode: RECOLOUR_TRANSPARENT;
          palette: PALETTE_TRANSPARENT;
  }
}

switch(FEAT_STATIONS, SELF, depot_anim_next_frame_nopbs, animation_frame) {
  0: return 0;
  4: return 10;
 14: return 0;
     return CB_RESULT_NEXT_FRAME;
}
switch(FEAT_STATIONS, SELF, depot_anim_next_frame_pbs, animation_frame) {
  4: return 4;
 14: return 0;
     return CB_RESULT_NEXT_FRAME;
}
switch(FEAT_STATIONS, SELF, depot_anim_next_frame, pbs_reserved) {
  1: depot_anim_next_frame_pbs;
     depot_anim_next_frame_nopbs;
}

item(FEAT_STATIONS, depot) {
  property {
                class: "WAYP";
                 name: string(STR_STATION_NAME_DEPOT_ENTRANCE);
      hide_wire_tiles: STAT_ALL_TILES;
     draw_pylon_tiles: STAT_ALL_TILES;
       animation_info: [ANIMATION_LOOPING, 253];
      animation_speed: 3;
   animation_triggers: bitmask(STAT_ANIM_250_TICKS);
  }
  graphics {
               anim_control: return CB_RESULT_START_ANIMATION;
            anim_next_frame: depot_anim_next_frame;
             prepare_layout: calculate_depot();
    purchase_prepare_layout: calculate_depot_menu();
             sprite_layouts: [depot_X, depot_Y];
  }
}
