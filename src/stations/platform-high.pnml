          yextent: 16;
          zextent: 8;
           sprite: platform_high(1 + LOAD_TEMP(0) * SPRITES_PER_ROW_PLATFORM_HIGH);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 12;
          yoffset: 0;
          zoffset: 0;
          xextent: 4;
          yextent: 16;
          zextent: 8;
           sprite: platform_high(3 + LOAD_TEMP(1) * SPRITES_PER_ROW_PLATFORM_HIGH);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

item(FEAT_STATIONS, platform_high_all) {
  property {
        class: "HPLF";
    classname: string(STR_STATION_CLASSNAME_PLATFORM_HIGH);
         name: string(STR_STATION_NAME_PLATFORM_HIGH);
  }
  graphics {
    prepare_layout: calculate_platform_high();
    sprite_layouts: [platform_high_X_all, platform_high_Y_all];
  }
}

