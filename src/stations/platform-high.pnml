  /// platforms

spriteset(platform_high, "src/stations/platform-high.png")
{
  abstract_template(2 + 80*0, 2 + 49*0, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*0, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*0, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*0, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*1, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*1, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*1, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*1, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*2, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*2, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*2, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*2, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*3, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*3, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*3, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*3, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*4, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*4, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*4, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*4, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*5, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*5, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*5, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*5, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*6, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*6, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*6, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*6, 64, 47, -31+24, -16-12)

  abstract_template(2 + 80*0, 2 + 49*7, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*7, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*7, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*7, 64, 47, -31+24, -16-12)

}

#define SPRITES_PER_ROW_PLATFORM_HIGH 4
/* bits schema
North  R0(0)  R1(0)                 R0(0)
          ##||##               R0(1) #//R1(0)
    R0(1) ##||## R1(1)              #//#
          ##||##               R0(2)//# R1(1)
       R0(2)  R1(2)   South         R1(2)
*/

switch(FEAT_STATIONS, SELF, calculate_platform_high,
[ STORE_TEMP(
  check_station_id_non_perp(-1,0, platform_high_all) +
  check_station_id_non_perp(-1,0, platform_high_left) +
  check_station_id_non_perp(-1,0, crossing_pedastrian) +
  check_station_id_non_perp(0,-1, platform_high_all) * 2 +
  check_station_id_non_perp(0,-1, platform_high_right) * 2 +
  check_station_id_non_perp(0,-1, crossing_pedastrian) * 2 +
  check_station_id_non_perp(1,0, platform_high_all) * 4 +
  check_station_id_non_perp(1,0, platform_high_left) * 4 +
  check_station_id_non_perp(1,0, crossing_pedastrian) * 4, 0),
  STORE_TEMP(0x07 - LOAD_TEMP(0), 0),
  STORE_TEMP(
  check_station_id_non_perp(-1,0, platform_high_all) +
  check_station_id_non_perp(-1,0, platform_high_right) +
  check_station_id_non_perp(-1,0, crossing_pedastrian) +
  check_station_id_non_perp(0,1, platform_high_all) * 2 +
  check_station_id_non_perp(0,1, platform_high_left) * 2 +
  check_station_id_non_perp(0,1, crossing_pedastrian) * 2 +
  check_station_id_non_perp(1,0, platform_high_all) * 4 +
  check_station_id_non_perp(1,0, platform_high_right) * 4 +
  check_station_id_non_perp(1,0, crossing_pedastrian) * 4 , 1),
  STORE_TEMP(0x07 - LOAD_TEMP(1), 1)] )
{ return; }

spritelayout platform_high_X_nw {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 16;
          yextent: 4;
          zextent: 8;
           sprite: platform_high(0 + LOAD_TEMP(0) * SPRITES_PER_ROW_PLATFORM_HIGH);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

spritelayout platform_high_Y_ne {
  ground {
    sprite: GROUNDSPRITE_RAIL_Y ;
