          yextent: 4;
          zextent: 8;
           sprite: platform_high(0 + LOAD_TEMP(0) * SPRITES_PER_ROW_PLATFORM_HIGH);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
  building {
          xoffset: 0;
          yoffset: 12;
          zoffset: 0;
          xextent: 16;
          yextent: 4;
          zextent: 8;
           sprite: platform_high(2 + LOAD_TEMP(1) * SPRITES_PER_ROW_PLATFORM_HIGH);
