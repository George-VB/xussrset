  /// platform low

spriteset(platform_low, "src/stations/platform-low.png")
{
  abstract_template(2 + 80*0, 2 + 49*0, 64, 47, -31,    -16)
  abstract_template(2 + 80*1, 2 + 49*0, 64, 47, -31,    -16)
  abstract_template(2 + 80*2, 2 + 49*0, 64, 47, -31-24, -16-12)
  abstract_template(2 + 80*3, 2 + 49*0, 64, 47, -31+24, -16-12)
}

spritelayout platform_low_X_nw {
  ground {
    sprite: GROUNDSPRITE_RAIL_X ;
  }
  building {
          xoffset: 0;
          yoffset: 0;
          zoffset: 0;
          xextent: 16;
          yextent: 4;
          zextent: 2;
      always_draw: 1;
           sprite: platform_low(0);
    recolour_mode: RECOLOUR_REMAP;
          palette: PALETTE_USE_DEFAULT;
  }
}

