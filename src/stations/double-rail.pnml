#define SPRITE_DOUBLE_RAIL 12
#define MAX_SPRITE_DOUBLE_RAIL 12 * 8

spriteset(station_fences, "src/rails/fence.png")
{
  abstract_template(1,     1,    34, 22, -31-2, -5+1)
  abstract_template(1+48,  1,    34, 22,   0-1, -5)
  abstract_template(1,     1+46, 34, 22,   -31, -5+1)
  abstract_template(1+48,  1+46, 34, 22,   0-3, -5)
}
