{ return string(STR_REFIT_TTD_59); }

switch (FEAT_TRAINS, SELF, general_cargo_subtype_text_STR_REFIT_LV_RAL6002, 0)
{ return string(STR_REFIT_TTD_53); }

#define livery_subtemplate_long(lvnum, lvnamelong, lvyear)                                 \
switch (FEAT_TRAINS, SELF, general_cargo_subtype_text_long_##lvnum,                        \
  advanced_check_year(lvyear))                                                             \
{ 1: return string(lvnamelong);                                                            \
     return string(STR_REFIT_FACTORY); }                                                   \
switch (FEAT_TRAINS, SELF, general_cargo_subtype_text_short_##lvnum,                       \
  advanced_check_year(lvyear))                                                             \
{ 1: return string(lvnum);                                                                 \
     return string(STR_REFIT_FACTORY); }                                                   \
switch (FEAT_TRAINS, SELF, general_cargo_subtype_text_##lvnum, (disable_long_names == 0))  \
{ 0: general_cargo_subtype_text_short_##lvnum;                                             \
     general_cargo_subtype_text_long_##lvnum; }                                            \

#define livery_subtemplate(lvnum, lvyear)                       \
switch (FEAT_TRAINS, SELF, general_cargo_subtype_text_##lvnum,  \
  advanced_check_year(lvyear))                                  \
{ 1: return string(lvnum);                                      \
     return string(STR_REFIT_FACTORY); }                        \

