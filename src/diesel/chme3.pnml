// chme3

#define PROP_chme3_CF  2 * 30
#define PROP_chme3_RC  232
#define PROP_chme3_SD  95
#define PROP_chme3_WT  123
#define PROP_chme3_TE  356.0
#define PROP_chme3_PR  970
#define PROP_chme3_CC  0

#define IMAGEFILE  "src/diesel/chme3.png"
purchase_sprites_with_icon(chme3_v1, 18, 0, diesel)
purchase_sprites_with_icon(chme3_v2, 118, 0, diesel)
diesel1r_sprites(10, chme3_v1, 32,  40)
diesel1r_sprites(10, chme3_v2, 32, 241)
diesel1r_sprites(10, chme3_v3, 32, 442)
diesel1r_sprites(10, chme3_v4, 32, 643)
#undef IMAGEFILE
purchase_sprites_select(chme3, GREAT_CHANGE_YEAR)

switch (FEAT_TRAINS, SELF, chme3_calculate_body, company_colour1)
// bit 0 - RAL 6020/Ral 6002
// bit 1,2 - before 1972 / Red line / no line
{
   0: return  2  +          0;   // DARK_BLUE
   1: return       0   +     1;  // PALE_GREEN
   2: return         4 +     1;  // PINK
   3: return        2  +     1;  // YELLOW
   4: return  2  +          0;   // RED
   5: return         4 +     1;  // LIGHT_BLUE
   6: return 0   +          0;   // GREEN
   7: return 0   +          0;   // DARK_GREEN
   8: return       0   +     1;  // BLUE
   9: return        2  +     1;  // CREAM
  10: return   4 +          0;   // MAUVE
  11: return   4 +          0;   // PURPLE
  12: return        2  +     1;  // ORANGE
  13: return  2  +          0;   // BROWN
  14: return 0   +          0;   // GREY
  15: return       0   +     1;  // WHITE
      return 0;
}

switch (FEAT_TRAINS, SELF, chme3_sprites_left_RND,
[  set_offset_to(1),
   prev_vehicle_randombits() & 0x01])
{
  0: chme3_v2_sprites_left;
     chme3_v3_sprites_left;
}

switch (FEAT_TRAINS, SELF, chme3_year_sprites_left,
  check_year(GREAT_CHANGE_YEAR))
{
  0: chme3_v1_sprites_left;
     chme3_sprites_left_RND;
}

switch (FEAT_TRAINS, SELF, chme3_year_sprites_left_noRND,
  check_year(GREAT_CHANGE_YEAR))
{
  0: chme3_v1_sprites_left;
     chme3_v3_sprites_left;
}

switch (FEAT_TRAINS, SELF, chme3_year_sprites_left_group,
  chme3_calculate_body())
{
  0: chme3_v1_sprites_left;
  1: chme3_v1_sprites_left;
  2: chme3_v2_sprites_left;
  3: chme3_v2_sprites_left;
  4: chme3_v3_sprites_left;
     chme3_v3_sprites_left;
}

switch (FEAT_TRAINS, SELF, chme3_sprites_right,  // TODO fix graphics, not code!!
  cargo_subtype)
{
                     0: chme3_year_sprites_left;
            LV_RAL6002: chme3_year_sprites_left_noRND;
            LV_RAL6020: chme3_year_sprites_left_noRND;
  LV_UKRAINIAN_RAILWAY: chme3_v2_sprites_left;
            LV_RZD_PID: chme3_v4_sprites_left;
                  0xF0: chme3_year_sprites_left_group;
  align_10_sprites;
}

switch (FEAT_TRAINS, SELF, chme3_sprites_right_RND,
[  set_offset_to(1),
   prev_vehicle_randombits() & 0x01])
{
  0: chme3_v2_sprites_right;
     chme3_v3_sprites_right;
}

switch (FEAT_TRAINS, SELF, chme3_year_sprites_right,
  check_year(GREAT_CHANGE_YEAR))
{
  0: chme3_v1_sprites_right;
     chme3_sprites_right_RND;
}

switch (FEAT_TRAINS, SELF, chme3_year_sprites_right_noRDND,
  check_year(GREAT_CHANGE_YEAR))
{
  0: chme3_v1_sprites_right;
     chme3_v2_sprites_right;
}

switch (FEAT_TRAINS, SELF, chme3_year_sprites_right_group,
  chme3_calculate_body())
{
  0: chme3_v1_sprites_right;
  1: chme3_v1_sprites_right;
  2: chme3_v2_sprites_right;
  3: chme3_v2_sprites_right;
  4: chme3_v3_sprites_right;
     chme3_v3_sprites_right;
}

switch (FEAT_TRAINS, SELF, chme3_sprites_left,  // TODO fix graphics, not code!!
  cargo_subtype)
{
                     0: chme3_year_sprites_right;
            LV_RAL6002: chme3_year_sprites_right_noRDND;
            LV_RAL6020: chme3_year_sprites_right_noRDND;
  LV_UKRAINIAN_RAILWAY: chme3_v2_sprites_right;
            LV_RZD_PID: chme3_v4_sprites_right;
                  0xF0: chme3_year_sprites_right_group;
  align_10_sprites;
}

engine_direction_template(chme3, chme3)
engine_RND_direction_template(chme3, chme3, 1, 1)
long_vehicle_advanced(chme3, chme3_sprites_start_sp)

switch (FEAT_TRAINS, SELF, chme3_colour_mapping_CC_group,
[  STORE_TEMP(company_colour2, 0),
  chme3_calculate_body() * 2 +
  calculate_colour3() ])
{
// before 1972
  0: return ttd_cc2 + 0x49;
  1: return ttd_cc2 + 0x46;
  2: return ttd_cc2 + 0x4A;
  3: return ttd_cc2 + 0x47;
// with red line
  4: return ttd_cc2 + 0x49;
  5: return ttd_cc2 + 0x46;
  6: return ttd_cc2 + 0x4A;
  7: return ttd_cc2 + 0x47;
// without red line
  8: return ttd_cc2 + 0x49;
  9: return ttd_cc2 + 0x46;
 10: return ttd_cc2 + 0x4A;
 11: return ttd_cc2 + 0x47;
  return CB_FAILED;
}

switch (FEAT_TRAINS, SELF, chme3_colour_mapping_CC,
  cargo_subtype)
{
                     0: return ttd_cc2 + 0x49;
            LV_RAL6002: return ttd_cc2 + 0x49;
            LV_RAL6020: return ttd_cc2 + 0x4A;
  LV_UKRAINIAN_RAILWAY: return ttd_cc2 + 0x3E;
                  0xF0: chme3_colour_mapping_CC_group;
  return CB_FAILED;
}

switch (FEAT_TRAINS, SELF, chme3_colour_mapping_2CC,
  cargo_subtype)
{
                     0: return ttd_cc2 + 0x46;
            LV_RAL6002: return ttd_cc2 + 0x46;
            LV_RAL6020: return ttd_cc2 + 0x47;
  LV_UKRAINIAN_RAILWAY: return ttd_cc2 + 0x48;
                  0xF0: chme3_colour_mapping_CC_group;
  return CB_FAILED;
}

switch (FEAT_TRAINS, SELF, chme3_colour_mapping,
[  set_offset_to(1),
   prev_vehicle_randombits() >> 1 & 0x01])
{
  0: chme3_colour_mapping_CC;
     chme3_colour_mapping_2CC;
}

  livery_template_base_list4(chme3_refit, LV_RAL6020, LV_RAL6002, LV_UKRAINIAN_RAILWAY, LV_RZD_PID)
livery_template_simplerefit_shifted(chme3, 0xF0, STR_REFIT_FACTORY_GENERAL_TYPE_SIMPLE_SP, STR_REFIT_LIVERY_TYPE_GROUP, chme3_refit_cargo_subtype_text)

engine_diesel_1r_effect(chme3_create_effect_sprites, 0, 2, 12)
engine_direction_template(chme3_create_effect, chme3)
engine_RND_direction_template(chme3_create_effect, chme3, 1, 1)
engine_speed(chme3, PROP_chme3_SD)
engine_penalise_speed(chme3, 2)
switch (FEAT_TRAINS, SELF, chme3_running_cost_factor,
[  STORE_TEMP(132, 0),  // Моторы
   STORE_TEMP(19, 1),   // Бригада
   STORE_TEMP(46, 2),   // Износ
   STORE_TEMP(0, 3),    // Сопровождение
   STORE_TEMP(32, 4),   // ТО
   STORE_TEMP(2, 5),    // Сертификация

   STORE_TEMP(PROP_chme3_SD, 6),          // Скорость
   STORE_TEMP(round(PROP_chme3_WT), 7),   // Тара
   STORE_TEMP(round(PROP_chme3_WT), 8)])  // Максимальная масса
{ all_running_cost_factor; }              // 232

name_in_group(chme3, string(STR_NAME_IN_GROUP, string(STR_NAME_CHME3_SERIES), string(STR_NAME_CHME3)),
                     string(STR_NAME_IN_GROUP, string(STR_NAME_CHME3_SERIES), string(STR_LONGNAME_CHME3)))

hint_engine(chme3,
     STR_PURCHASE_HINT_ENGINE_TYPE_SHUNTING_DIESEL,
     STR_PURCHASE_HINT_SECTIONS_1_2,
     1964, 1988,
     fact_chkd())

item (FEAT_TRAINS, chme3, 202) {
  property {
    name: string(STR_NAME_CHME3);
    vehicle_dates(1964, 1988, 25, 10, 8, PROP_chme3_CF)
    vehicle_cargo()
    vehicle_diesel(PROP_chme3_PR, PROP_chme3_WT, PROP_chme3_TE, _lowspeed)
    vehicle_group_pre(group_chme3)
  }
  graphics {
    purchase_menu(PROP_chme3_CF, PROP_chme3_RC, PROP_chme3_SD, PROP_chme3_WT, PROP_chme3_TE, PROP_chme3_PR, PROP_chme3_CC)
         additional_text: chme3_additional_text;
        articulated_part: articulated_part_dummy2;
    bitmask_vehicle_info: chme3_bitmask_vehicle_info;
        can_attach_wagon: any_can_attach_wagon_diesel;
          cargo_capacity: return PROP_chme3_CC;
      cargo_subtype_text: chme3_cargo_subtype_text;
          colour_mapping: chme3_colour_mapping;
           create_effect: chme3_create_effect_sprites_start_sp;
                 default: chme3_sprites;
                    name: chme3_name;
                purchase: chme3_purchase_sprites;
     running_cost_factor: chme3_running_cost_factor;
                   speed: chme3_speed;
              start_stop: any_start_stop_diesel;
  }
}

long_name_template(chme3, STR_LONGNAME_CHME3)
models_default_cargo_template_shunting(chme3)
allow_diesel(chme3)
