 /// header

grf
{
                   grfid: "AKA\08";
                    name: string(STR_GRF_NAME);
                    desc: string(STR_GRF_DESC);
                     url: string(STR_GRF_URL);
                 version: REPO_REVISION;
  min_compatible_version: MIN_COMPATIBLE_REVISION;
  param 0
  {
    disable_icons
    {
           name: string(STR_PARAM_DISABLE_ICONS_NAME);
           desc: string(STR_PARAM_DISABLE_ICONS_DESC);
           type: bool;
            bit: 6;
      def_value: 0;
    }
    disable_long_names
    {
           name: string(STR_PARAM_DISABLE_LONG_NAMES_NAME);
           desc: string(STR_PARAM_DISABLE_LONG_NAMES_DESC);
           type: bool;
            bit: 7;
      def_value: 0;
    }
    disable_groups
    {
           name: string(STR_PARAM_DISABLE_GROUPS_NAME);
           desc: string(STR_PARAM_DISABLE_GROUPS_DESC);
           type: bool;
            bit: 4;
      def_value: 0;
    }
  }
  param 1
  {
    speed_penalty_percent
    {
           type: int;
           name: string(STR_PARAM_SPEED_PENALTY_PERCENT_NAME);
           desc: string(STR_PARAM_SPEED_PENALTY_PERCENT_DESC);
      min_value: 0;
      max_value: 50;
      def_value: 15;
    }
  }
  param 2
  {
    new_costs
    {
           type: int;
           name: string(STR_PARAM_CBASE_NAME);
           desc: string(STR_PARAM_CBASE_DESC);
      min_value: 0;
      max_value: 3;
      def_value: 0;
      names:
      {
        0: string(STR_PARAM_BASE_DEFAULT);
        1: string(STR_PARAM_BASE_HALVED);
        2: string(STR_PARAM_BASE_QUARTERED);
        3: string(STR_PARAM_BASE_EIGHT);
      };
    }
  }
  param 3
  {
    new_rcosts
    {
           type: int;
           name: string(STR_PARAM_RCBASE_NAME);
           desc: string(STR_PARAM_RCBASE_DESC);
      min_value: 0;
      max_value: 3;
      def_value: 0;
      names:
      {
        0: string(STR_PARAM_BASE_DEFAULT);
        1: string(STR_PARAM_BASE_HALVED);
        2: string(STR_PARAM_BASE_QUARTERED);
        3: string(STR_PARAM_BASE_EIGHT);
      };
    }
  }
  param 4
  {
    disable_steamer
    {
           name: string(STR_PARAM_DISABLE_STEAMER_NAME);
           desc: string(STR_PARAM_DISABLE_STEAMER_DESC);
           type: bool;
            bit: 0;
      def_value: 0;
    }
    disable_diesel
    {
           name: string(STR_PARAM_DISABLE_DIESEL_NAME);
           desc: string(STR_PARAM_DISABLE_DIESEL_DESC);
           type: bool;
            bit: 1;
      def_value: 0;
    }
    disable_acelectric
    {
           name: string(STR_PARAM_DISABLE_ACELECTRIC_NAME);
           desc: string(STR_PARAM_DISABLE_ACELECTRIC_DESC);
           type: bool;
            bit: 2;
      def_value: 0;
    }
    disable_dcelectric
    {
           name: string(STR_PARAM_DISABLE_DCELECTRIC_NAME);
           desc: string(STR_PARAM_DISABLE_DCELECTRIC_DESC);
           type: bool;
            bit: 3;
      def_value: 0;
    }
    disable_acdcelectric
    {
           name: string(STR_PARAM_DISABLE_ACDCELECTRIC_NAME);
           desc: string(STR_PARAM_DISABLE_ACDCELECTRIC_DESC);
           type: bool;
            bit: 4;
      def_value: 0;
    }
    disable_dmu
    {
           name: string(STR_PARAM_DISABLE_DMU_NAME);
           desc: string(STR_PARAM_DISABLE_DMU_DESC);
           type: bool;
            bit: 5;
      def_value: 0;
    }
    disable_acemu
    {
           name: string(STR_PARAM_DISABLE_ACEMU_NAME);
           desc: string(STR_PARAM_DISABLE_ACEMU_DESC);
           type: bool;
            bit: 6;
      def_value: 0;
    }
    disable_dcemu
    {
           name: string(STR_PARAM_DISABLE_DCEMU_NAME);
           desc: string(STR_PARAM_DISABLE_DCEMU_DESC);
           type: bool;
            bit: 7;
      def_value: 0;
    }
    disable_acdcemu
    {
           name: string(STR_PARAM_DISABLE_ACDCEMU_NAME);
           desc: string(STR_PARAM_DISABLE_ACDCEMU_DESC);
           type: bool;
            bit: 8;
      def_value: 0;
    }
    disable_subway
    {
           name: string(STR_PARAM_DISABLE_SUBWAY_NAME);
           desc: string(STR_PARAM_DISABLE_SUBWAY_DESC);
           type: bool;
            bit: 9;
      def_value: 0;
    }
    disable_wagon
    {
           name: string(STR_PARAM_DISABLE_WAGON_NAME);
           desc: string(STR_PARAM_DISABLE_WAGON_DESC);
           type: bool;
            bit: 10;
      def_value: 0;
    }
    disable_car
    {
           name: string(STR_PARAM_DISABLE_CAR_NAME);
           desc: string(STR_PARAM_DISABLE_CAR_DESC);
           type: bool;
            bit: 11;
      def_value: 0;
    }
  }
}

#define anystate(GRF_ID)      \
grf_future_status(GRF_ID) ||  \
grf_current_status(GRF_ID)    \

disable_wagon = 0;
if (anystate("Meo\B7"))
{
  disable_wagon = 1;
  param[4] = param[4] | 0x400;
}

disable_car = 0;
if (anystate("Meo\B8"))
{
  disable_car = 1;
  param[4] = param[4] | 0x800;
}

disable_subway = 0;
if (anystate("Meo\B9"))
{
  disable_subway = 1;
  param[4] = param[4] | 0x200;
}
